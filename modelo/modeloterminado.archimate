  <folder name="Application" id="id-5eba5323037e46b69b717462ae126a28" type="application">
    <element xsi:type="archimate:ApplicationComponent" name="SGMF - Sistema de Gestión de Mantenimiento de Flota" id="ac-sgmf">
      <documentation>Aplicación a construir: responde si cada dron puede volar hoy y lleva la vida de drones, componentes y baterías. Se compone de 9 contextos.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Contexto Aeronavegabilidad y estado de flota" id="ac-aeronav">
      <documentation>Candidato a contexto delimitado o microservicio. Núcleo: decide si un dron puede volar hoy y por qué (bloqueo por vencimiento o novedad, diferimiento con límites, liberación con técnico certificado). Es la pregunta central de la empresa y concentra el riesgo de seguridad y de aseguradora. Ningún software genérico trae estas reglas.</documentation>
      <property key="Clasificación" value="Núcleo"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Contexto Planeación del mantenimiento" id="ac-planeacion">
      <documentation>Candidato a contexto delimitado o microservicio. Núcleo: reglas propias (lo que ocurra primero, tolerancia del 90 %, intervalos ajustados por base, paquetes de servicio, proyección a 30 días con repuestos). Evita casos como el de julio de 2026 y hoy solo vive en la cabeza y el Excel del jefe.</documentation>
      <property key="Clasificación" value="Núcleo"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Contexto Configuración de flota y vida de componentes" id="ac-configuracion">
      <documentation>Candidato a contexto delimitado o microservicio. Núcleo: componentes y baterías con vida propia que conservan horas y ciclos al cambiar de dron o de base. Llevar solo las horas por dron no es suficiente; una de las caídas de 2025 ocurrió por no tener este control.</documentation>
      <property key="Clasificación" value="Núcleo"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Contexto Registro de uso" id="ac-uso">
      <documentation>Candidato a contexto delimitado o microservicio. Soporte: indispensable para alimentar los contadores, pero es normalización de datos. No diferencia al negocio.</documentation>
      <property key="Clasificación" value="Soporte"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Contexto Órdenes de trabajo" id="ac-ot">
      <documentation>Candidato a contexto delimitado o microservicio. Soporte: flujo de órdenes de trabajo con checklist, firmas y sin conexión. Es un patrón conocido de mantenimiento adaptado a reglas propias (doble firma, inspección remota).</documentation>
      <property key="Clasificación" value="Soporte"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Contexto Abastecimiento de repuestos" id="ac-abastecimiento">
      <documentation>Candidato a contexto delimitado o microservicio. Soporte: Siigo es el dueño de existencias y costo; aquí solo reservas por OT, consumos y faltantes proyectados por base.</documentation>
      <property key="Clasificación" value="Soporte"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Contexto Personal habilitado" id="ac-personal">
      <documentation>Candidato a contexto delimitado o microservicio. Genérico: réplica de certificaciones que lleva Talento humano; el SGMF solo consulta vigencia y modelos habilitados.</documentation>
      <property key="Clasificación" value="Genérico"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Contexto Indicadores y reportes" id="ac-indicadores">
      <documentation>Candidato a contexto delimitado o microservicio. Genérico: modelos de lectura (KPI) y documentos PDF construidos con datos de los otros dominios; es un dominio de reportes y auditoría común a cualquier sistema.</documentation>
      <property key="Clasificación" value="Genérico"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Contexto Identidad y notificaciones" id="ac-plataforma">
      <documentation>Candidato a contexto delimitado o microservicio. Genérico: inicio de sesión con Google, roles y notificaciones por correo o push; servicios estándar del mercado.</documentation>
      <property key="Clasificación" value="Genérico"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Plataforma DJI Agras" id="ext-dji">
      <documentation>Sistema externo.</documentation>
      <property key="Tipo" value="Externo"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Plataforma XAG" id="ext-xag">
      <documentation>Sistema externo.</documentation>
      <property key="Tipo" value="Externo"/>
    </element>
