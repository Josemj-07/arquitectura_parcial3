    <element xsi:type="archimate:Contract" name="Contrato: Disponibilidad de flota" id="ct-bs-disponibilidad">
      <documentation>Entrada: dron (opcional), rango de fechas
Salida: Por dron y día: estado, motivo, restricciones, próxima ventana
Precondición: Usuario autenticado
Errores: Dron inexistente: rechazo. Rango mayor a 30 días: rechazo.
Protocolo: REST/JSON
No funcional: Consultable por otros sistemas; &lt; 2 s</documentation>
      <property key="Entrada" value="dron (opcional), rango de fechas"/>
      <property key="Salida" value="Por dron y día: estado, motivo, restricciones, próxima ventana"/>
      <property key="Precondición" value="Usuario autenticado"/>
      <property key="No funcional" value="Consultable por otros sistemas; &lt; 2 s"/>
      <property key="Errores" value="Dron inexistente: rechazo. Rango mayor a 30 días: rechazo."/>
      <property key="Protocolo" value="REST/JSON"/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato: Mantenimiento de flota (preventivo y correctivo)" id="ct-bs-mantenimiento">
      <documentation>Entrada: dron, base, periodo o novedad
Salida: Plan aprobado, OT ejecutadas, dron liberado
Precondición: Plan maestro vigente
Errores: Modelo sin plan maestro: no se programa. Dron dado de baja: rechazo.
Protocolo: REST/JSON
No funcional: Sin conexión en campo y taller</documentation>
      <property key="Entrada" value="dron, base, periodo o novedad"/>
      <property key="Salida" value="Plan aprobado, OT ejecutadas, dron liberado"/>
      <property key="Precondición" value="Plan maestro vigente"/>
      <property key="No funcional" value="Sin conexión en campo y taller"/>
      <property key="Errores" value="Modelo sin plan maestro: no se programa. Dron dado de baja: rechazo."/>
      <property key="Protocolo" value="REST/JSON"/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato: Evidencia de mantenimiento" id="ct-bs-evidencia">
      <documentation>Entrada: dron o grupo, periodo
Salida: Libro PDF, constancia, indicadores
Precondición: Registros firmados
Errores: Registros sin firma: se excluyen y se informa.
Protocolo: REST/JSON y PDF
No funcional: Disponible en minutos</documentation>
      <property key="Entrada" value="dron o grupo, periodo"/>
      <property key="Salida" value="Libro PDF, constancia, indicadores"/>
      <property key="Precondición" value="Registros firmados"/>
      <property key="No funcional" value="Disponible en minutos"/>
      <property key="Errores" value="Registros sin firma: se excluyen y se informa."/>
      <property key="Protocolo" value="REST/JSON y PDF"/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato: Consultar estado del dron" id="ct-dfs-consultar-estado">
      <documentation>Entrada: dron, fecha
Salida: estado (disponible, con restricción, en mantenimiento, en tierra, fuera de servicio, baja), motivos, próximo vencimiento
Precondición: Dron registrado
Errores: Dron no existe: rechazo. Sin conexión: muestra la última sincronización con su fecha.
Protocolo: REST/JSON; caché local en Android
No funcional: Con caché sin conexión</documentation>
      <property key="Entrada" value="dron, fecha"/>
      <property key="Salida" value="estado (disponible, con restricción, en mantenimiento, en tierra, fuera de servicio, baja), motivos, próximo vencimiento"/>
      <property key="Precondición" value="Dron registrado"/>
      <property key="No funcional" value="Con caché sin conexión"/>
      <property key="Errores" value="Dron no existe: rechazo. Sin conexión: muestra la última sincronización con su fecha."/>
      <property key="Protocolo" value="REST/JSON; caché local en Android"/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato: Registrar prevuelo y novedades" id="ct-dfs-prevuelo-novedad">
      <documentation>Entrada: dron, piloto, checklist o (categoría, descripción, fotos)
Salida: prevuelo registrado o novedad; dron en tierra si falla
Precondición: Piloto habilitado para el modelo
Errores: Piloto no habilitado para el modelo: rechazo. Dron en tierra: no permite prevuelo. Sin señal: se guarda y sincroniza.
Protocolo: App Android sin conexión; REST/JSON al sincronizar
No funcional: Prevuelo &lt; 1 min, novedad &lt; 2 min, sin conexión</documentation>
      <property key="Entrada" value="dron, piloto, checklist o (categoría, descripción, fotos)"/>
      <property key="Salida" value="prevuelo registrado o novedad; dron en tierra si falla"/>
      <property key="Precondición" value="Piloto habilitado para el modelo"/>
      <property key="No funcional" value="Prevuelo &lt; 1 min, novedad &lt; 2 min, sin conexión"/>
      <property key="Errores" value="Piloto no habilitado para el modelo: rechazo. Dron en tierra: no permite prevuelo. Sin señal: se guarda y sincroniza."/>
      <property key="Protocolo" value="App Android sin conexión; REST/JSON al sincronizar"/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato: Liberar dron a servicio" id="ct-dfs-liberar">
      <documentation>Entrada: dron, orden de trabajo, técnico
Salida: nuevo estado del dron y firma
Precondición: Técnico certificado; sin vencidas ni novedades abiertas
Errores: Técnico sin certificación vigente, tareas vencidas o novedades abiertas: rechazo.
Protocolo: REST/JSON
No funcional: Firma digital sencilla auditada</documentation>
      <property key="Entrada" value="dron, orden de trabajo, técnico"/>
      <property key="Salida" value="nuevo estado del dron y firma"/>
      <property key="Precondición" value="Técnico certificado; sin vencidas ni novedades abiertas"/>
      <property key="No funcional" value="Firma digital sencilla auditada"/>
      <property key="Errores" value="Técnico sin certificación vigente, tareas vencidas o novedades abiertas: rechazo."/>
      <property key="Protocolo" value="REST/JSON"/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato: Gestionar diferimiento" id="ct-dfs-diferir">
      <documentation>Entrada: tarea vencida, justificación, límite, aprobador
Salida: diferimiento; dron disponible con restricción
Precondición: Tarea no crítica, sin diferimiento previo, máximo 10 % o 7 días
Errores: Tarea crítica, segundo diferimiento o límite mayor al 10 % o 7 días: rechazo.
Protocolo: REST/JSON
No funcional: Solo jefe o delegado</documentation>
      <property key="Entrada" value="tarea vencida, justificación, límite, aprobador"/>
      <property key="Salida" value="diferimiento; dron disponible con restricción"/>
      <property key="Precondición" value="Tarea no crítica, sin diferimiento previo, máximo 10 % o 7 días"/>
      <property key="No funcional" value="Solo jefe o delegado"/>
      <property key="Errores" value="Tarea crítica, segundo diferimiento o límite mayor al 10 % o 7 días: rechazo."/>
      <property key="Protocolo" value="REST/JSON"/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato: Calcular vencimientos" id="ct-dfs-vencimientos">
      <documentation>Entrada: dron/componente/batería, contadores
Salida: vencimientos: tarea, % consumido, próxima fecha u horas, estado
Precondición: Plan maestro vigente
Errores: Contador que retrocede o tarea sin condición: alerta al jefe.
Protocolo: Interno (eventos de dominio)
No funcional: Recalcula al registrar uso o cerrar OT</documentation>
      <property key="Entrada" value="dron/componente/batería, contadores"/>
      <property key="Salida" value="vencimientos: tarea, % consumido, próxima fecha u horas, estado"/>
      <property key="Precondición" value="Plan maestro vigente"/>
      <property key="No funcional" value="Recalcula al registrar uso o cerrar OT"/>
      <property key="Errores" value="Contador que retrocede o tarea sin condición: alerta al jefe."/>
      <property key="Protocolo" value="Interno (eventos de dominio)"/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato: Planear semana y proyectar 30 días" id="ct-dfs-planear">
      <documentation>Entrada: semana, base, asignaciones, horizonte 30 días
Salida: plan propuesto/aprobado y repuestos requeridos por base
Precondición: Vencimientos calculados
Errores: Sin asignaciones de Programación: proyecta con el ritmo histórico. Sin existencias: sin dato.
Protocolo: REST/JSON
No funcional: Aprobación del jefe</documentation>
      <property key="Entrada" value="semana, base, asignaciones, horizonte 30 días"/>
      <property key="Salida" value="plan propuesto/aprobado y repuestos requeridos por base"/>
      <property key="Precondición" value="Vencimientos calculados"/>
      <property key="No funcional" value="Aprobación del jefe"/>
      <property key="Errores" value="Sin asignaciones de Programación: proyecta con el ritmo histórico. Sin existencias: sin dato."/>
      <property key="Protocolo" value="REST/JSON"/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato: Registrar aviso del fabricante" id="ct-dfs-aviso">
      <documentation>Entrada: fabricante, descripción, alcance (modelo o serie), fecha límite
Salida: tareas únicas sobre los equipos afectados
Precondición: Jefe de mantenimiento
Errores: Alcance sin equipos afectados: se registra sin tareas. Fecha límite vencida: alerta.
Protocolo: REST/JSON
No funcional: Obligatoria</documentation>
      <property key="Entrada" value="fabricante, descripción, alcance (modelo o serie), fecha límite"/>
      <property key="Salida" value="tareas únicas sobre los equipos afectados"/>
      <property key="Precondición" value="Jefe de mantenimiento"/>
      <property key="No funcional" value="Obligatoria"/>
      <property key="Errores" value="Alcance sin equipos afectados: se registra sin tareas. Fecha límite vencida: alerta."/>
      <property key="Protocolo" value="REST/JSON"/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato: Gestionar configuración de dron" id="ct-dfs-configuracion">
      <documentation>Entrada: dron, posición, componente, motivo (vencimiento, falla, canibalización)
Salida: configuración instalada e historial
Precondición: Posición libre; canibalización autorizada
Errores: Posición ocupada, componente instalado en otro dron o canibalización sin autorización: rechazo.
Protocolo: REST/JSON
No funcional: Contadores conservados</documentation>
      <property key="Entrada" value="dron, posición, componente, motivo (vencimiento, falla, canibalización)"/>
      <property key="Salida" value="configuración instalada e historial"/>
      <property key="Precondición" value="Posición libre; canibalización autorizada"/>
      <property key="No funcional" value="Contadores conservados"/>
      <property key="Errores" value="Posición ocupada, componente instalado en otro dron o canibalización sin autorización: rechazo."/>
      <property key="Protocolo" value="REST/JSON"/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato: Gestionar baterías" id="ct-dfs-bateria">
      <documentation>Entrada: batería, acción (cuarentena, retirar, liberar), salud %
Salida: nuevo estado de batería
Precondición: Inspección registrada
Errores: Liberar de cuarentena sin evaluación: rechazo.
Protocolo: REST/JSON
No funcional: Retiro notifica a SST</documentation>
      <property key="Entrada" value="batería, acción (cuarentena, retirar, liberar), salud %"/>
      <property key="Salida" value="nuevo estado de batería"/>
      <property key="Precondición" value="Inspección registrada"/>
      <property key="No funcional" value="Retiro notifica a SST"/>
      <property key="Errores" value="Liberar de cuarentena sin evaluación: rechazo."/>
      <property key="Protocolo" value="REST/JSON"/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato: Registrar y corregir uso de vuelo" id="ct-dfs-uso">
      <documentation>Entrada: archivo del fabricante o reporte manual; corrección con motivo
Salida: registros de uso, duplicados omitidos, inconsistencias
Precondición: Dron existe
Errores: Dron inexistente, vuelo solapado o duración absurda: inconsistencia. Duplicado: omitido. Corrección sin motivo: rechazo.
Protocolo: Archivo CSV/XLSX y REST/JSON
No funcional: Idempotente; nada se borra</documentation>
      <property key="Entrada" value="archivo del fabricante o reporte manual; corrección con motivo"/>
      <property key="Salida" value="registros de uso, duplicados omitidos, inconsistencias"/>
      <property key="Precondición" value="Dron existe"/>
      <property key="No funcional" value="Idempotente; nada se borra"/>
      <property key="Errores" value="Dron inexistente, vuelo solapado o duración absurda: inconsistencia. Duplicado: omitido. Corrección sin motivo: rechazo."/>
      <property key="Protocolo" value="Archivo CSV/XLSX y REST/JSON"/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato: Gestionar orden de trabajo" id="ct-dfs-ot">
      <documentation>Entrada: dron, tipo (preventiva, correctiva, aviso, inspección), tareas, técnico; resultados y fotos
Salida: OT programada o en ejecución; no conformes con acción
Precondición: Técnico certificado para el modelo
Errores: Técnico no certificado: rechazo. Valor fuera de rango: tarea no conforme. Sin señal: sincroniza luego.
Protocolo: REST/JSON; tablet sin conexión
No funcional: Sin conexión en tablet</documentation>
      <property key="Entrada" value="dron, tipo (preventiva, correctiva, aviso, inspección), tareas, técnico; resultados y fotos"/>
      <property key="Salida" value="OT programada o en ejecución; no conformes con acción"/>
      <property key="Precondición" value="Técnico certificado para el modelo"/>
      <property key="No funcional" value="Sin conexión en tablet"/>
      <property key="Errores" value="Técnico no certificado: rechazo. Valor fuera de rango: tarea no conforme. Sin señal: sincroniza luego."/>
      <property key="Protocolo" value="REST/JSON; tablet sin conexión"/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato: Firmar y cerrar orden de trabajo" id="ct-dfs-firmar-cerrar">
      <documentation>Entrada: orden de trabajo, firma (ejecución, inspección, remota), consumos, componentes
Salida: OT cerrada, que ya no se modifica; eventos a planeación, estado e inventario
Precondición: Inspector distinto del ejecutor en críticas
Errores: Inspector igual al ejecutor en tarea crítica o firmas incompletas: no cierra. OT cerrada: no se modifica.
Protocolo: REST/JSON
No funcional: Cierra aunque Siigo no responda</documentation>
      <property key="Entrada" value="orden de trabajo, firma (ejecución, inspección, remota), consumos, componentes"/>
      <property key="Salida" value="OT cerrada, que ya no se modifica; eventos a planeación, estado e inventario"/>
      <property key="Precondición" value="Inspector distinto del ejecutor en críticas"/>
      <property key="No funcional" value="Cierra aunque Siigo no responda"/>
      <property key="Errores" value="Inspector igual al ejecutor en tarea crítica o firmas incompletas: no cierra. OT cerrada: no se modifica."/>
      <property key="Protocolo" value="REST/JSON"/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato: Registrar envío a taller externo" id="ct-dfs-taller">
      <documentation>Entrada: dron/componente, taller, reporte de falla, fechas, informe
Salida: envío registrado; dron fuera de servicio; inspección de recibo
Precondición: Aprobación del jefe
Errores: Regreso sin informe del taller: el dron no se libera.
Protocolo: REST/JSON con adjunto PDF
No funcional: Adjuntos PDF</documentation>
      <property key="Entrada" value="dron/componente, taller, reporte de falla, fechas, informe"/>
      <property key="Salida" value="envío registrado; dron fuera de servicio; inspección de recibo"/>
      <property key="Precondición" value="Aprobación del jefe"/>
      <property key="No funcional" value="Adjuntos PDF"/>
      <property key="Errores" value="Regreso sin informe del taller: el dron no se libera."/>
      <property key="Protocolo" value="REST/JSON con adjunto PDF"/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato: Reservar y consumir repuestos" id="ct-dfs-repuestos">
      <documentation>Entrada: orden de trabajo o faltante, repuestos, bodega
Salida: reserva, consumo o solicitud de compra o traslado
Precondición: Existencia consultada
Errores: Existencia insuficiente: faltante. Siigo no disponible: salida en cola.
Protocolo: REST/JSON
No funcional: Tolera caída de Siigo</documentation>
      <property key="Entrada" value="orden de trabajo o faltante, repuestos, bodega"/>
      <property key="Salida" value="reserva, consumo o solicitud de compra o traslado"/>
      <property key="Precondición" value="Existencia consultada"/>
      <property key="No funcional" value="Tolera caída de Siigo"/>
      <property key="Errores" value="Existencia insuficiente: faltante. Siigo no disponible: salida en cola."/>
      <property key="Protocolo" value="REST/JSON"/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato: Generar indicadores y documentos" id="ct-dfs-reportes">
      <documentation>Entrada: periodo, base, modelo o dron, tipo de documento
Salida: indicadores (disponibilidad, cumplimiento, MTBF, MTTR, costo por hora) o PDF
Precondición: Registros firmados y costos de Siigo
Errores: Periodo sin cierre contable: costo provisional. Dron sin datos: se indica.
Protocolo: REST/JSON y PDF
No funcional: Mensual y bajo demanda</documentation>
      <property key="Entrada" value="periodo, base, modelo o dron, tipo de documento"/>
      <property key="Salida" value="indicadores (disponibilidad, cumplimiento, MTBF, MTTR, costo por hora) o PDF"/>
      <property key="Precondición" value="Registros firmados y costos de Siigo"/>
      <property key="No funcional" value="Mensual y bajo demanda"/>
      <property key="Errores" value="Periodo sin cierre contable: costo provisional. Dron sin datos: se indica."/>
      <property key="Protocolo" value="REST/JSON y PDF"/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato: Traducir registros de vuelo y baterías de los fabricantes" id="ct-acs-fabricantes-vuelos">
      <documentation>Entrada: Archivo exportado de la plataforma DJI Agras o XAG (columnas y formato de fecha propios de cada fabricante).
Salida: Registro de vuelo canónico: serie del dron, despegue, aterrizaje, duración, piloto, área y baterías (serie y ciclos; solo DJI).
Precondición: Fabricante con adaptador registrado; archivo cargado por el coordinador de base.
Errores: Columnas desconocidas: archivo rechazado. Dron no registrado, vuelo solapado o duración absurda: inconsistencia. Vuelo ya cargado: omitido.
Protocolo: Carga de archivo CSV/XLSX (no hay API abierta).
No funcional: Diaria. Agregar un fabricante solo requiere agregar un adaptador. El dato del fabricante prima sobre el manual.</documentation>
      <property key="Entrada" value="Archivo exportado de la plataforma DJI Agras o XAG (columnas y formato de fecha propios de cada fabricante)."/>
      <property key="Salida" value="Registro de vuelo canónico: serie del dron, despegue, aterrizaje, duración, piloto, área y baterías (serie y ciclos; solo DJI)."/>
      <property key="Precondición" value="Fabricante con adaptador registrado; archivo cargado por el coordinador de base."/>
      <property key="No funcional" value="Diaria. Agregar un fabricante solo requiere agregar un adaptador. El dato del fabricante prima sobre el manual."/>
      <property key="Errores" value="Columnas desconocidas: archivo rechazado. Dron no registrado, vuelo solapado o duración absurda: inconsistencia. Vuelo ya cargado: omitido."/>
      <property key="Protocolo" value="Carga de archivo CSV/XLSX (no hay API abierta)."/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato: Intercambiar inventario con Siigo" id="ct-acs-siigo">
      <documentation>Entrada: Catálogo de repuestos (código, nombre, unidad, costo promedio) y existencias por bodega/base.
Salida: Salidas de inventario al cerrar una OT; solicitudes de compra o de traslado entre bases.
Precondición: Credenciales de la API; códigos de repuesto iguales en ambos sistemas.
Errores: Siigo no disponible: la salida queda en cola y se reintenta. Código inexistente: aviso al almacenista. Documento no soportado por la API: queda para confirmación manual.
Protocolo: API REST/JSON de Siigo Nube.
No funcional: Existencias cada pocas horas o bajo demanda. Siigo es dueño del stock y del costo; el SGMF nunca se detiene por Siigo.</documentation>
      <property key="Entrada" value="Catálogo de repuestos (código, nombre, unidad, costo promedio) y existencias por bodega/base."/>
      <property key="Salida" value="Salidas de inventario al cerrar una OT; solicitudes de compra o de traslado entre bases."/>
      <property key="Precondición" value="Credenciales de la API; códigos de repuesto iguales en ambos sistemas."/>
      <property key="No funcional" value="Existencias cada pocas horas o bajo demanda. Siigo es dueño del stock y del costo; el SGMF nunca se detiene por Siigo."/>
      <property key="Errores" value="Siigo no disponible: la salida queda en cola y se reintenta. Código inexistente: aviso al almacenista. Documento no soportado por la API: queda para confirmación manual."/>
      <property key="Protocolo" value="API REST/JSON de Siigo Nube."/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato: Intercambiar disponibilidad con Programación" id="ct-acs-programacion">
      <documentation>Entrada: Asignaciones por día: dron, servicio, base y horas de vuelo estimadas.
Salida: Disponibilidad por dron y día (estado, motivo, restricciones, ventanas de mantenimiento) para 14 días; aviso inmediato de dron en tierra.
Precondición: Ninguna para consultar (interfaz abierta); el dron se identifica por su serie.
Errores: Asignación de un dron no disponible: rechazo y aviso al coordinador. Dron desconocido: rechazo.
Protocolo: Corto plazo: lectura de la hoja de Google Sheets o carga de archivo. Futuro: API REST/JSON publicada para la herramienta propia.
No funcional: Cambios de estado publicados de inmediato; consulta diaria de los próximos 14 días.</documentation>
      <property key="Entrada" value="Asignaciones por día: dron, servicio, base y horas de vuelo estimadas."/>
      <property key="Salida" value="Disponibilidad por dron y día (estado, motivo, restricciones, ventanas de mantenimiento) para 14 días; aviso inmediato de dron en tierra."/>
      <property key="Precondición" value="Ninguna para consultar (interfaz abierta); el dron se identifica por su serie."/>
      <property key="No funcional" value="Cambios de estado publicados de inmediato; consulta diaria de los próximos 14 días."/>
      <property key="Errores" value="Asignación de un dron no disponible: rechazo y aviso al coordinador. Dron desconocido: rechazo."/>
      <property key="Protocolo" value="Corto plazo: lectura de la hoja de Google Sheets o carga de archivo. Futuro: API REST/JSON publicada para la herramienta propia."/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato: Importar certificaciones de personal" id="ct-acs-personal">
      <documentation>Entrada: Persona, rol, tipo de certificación, modelos habilitados, fecha de expedición y vencimiento.
Salida: Habilitaciones actualizadas en el SGMF.
Precondición: Usuario de Talento humano.
Errores: Fecha inválida: fila rechazada. Persona sin usuario: queda pendiente.
Protocolo: Carga de archivo Excel o registro directo en pantalla.
No funcional: Bajo demanda; sin duplicar la lista de Talento humano.</documentation>
      <property key="Entrada" value="Persona, rol, tipo de certificación, modelos habilitados, fecha de expedición y vencimiento."/>
      <property key="Salida" value="Habilitaciones actualizadas en el SGMF."/>
      <property key="Precondición" value="Usuario de Talento humano."/>
      <property key="No funcional" value="Bajo demanda; sin duplicar la lista de Talento humano."/>
      <property key="Errores" value="Fecha inválida: fila rechazada. Persona sin usuario: queda pendiente."/>
      <property key="Protocolo" value="Carga de archivo Excel o registro directo en pantalla."/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato: Informar calibración a Agronomía" id="ct-acs-agronomia">
      <documentation>Entrada: Consulta del agrónomo por dron.
Salida: Fecha y resultado de la última calibración de boquillas y caudal; vigente o vencida.
Precondición: Usuario agrónomo.
Errores: Dron sin calibración vigente: no apto para aplicar.
Protocolo: Consulta en pantalla web/móvil (REST/JSON).
No funcional: Antes de autorizar cada aplicación.</documentation>
      <property key="Entrada" value="Consulta del agrónomo por dron."/>
      <property key="Salida" value="Fecha y resultado de la última calibración de boquillas y caudal; vigente o vencida."/>
      <property key="Precondición" value="Usuario agrónomo."/>
      <property key="No funcional" value="Antes de autorizar cada aplicación."/>
      <property key="Errores" value="Dron sin calibración vigente: no apto para aplicar."/>
      <property key="Protocolo" value="Consulta en pantalla web/móvil (REST/JSON)."/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato: Intercambiar costos con Finanzas" id="ct-acs-finanzas">
      <documentation>Entrada: Tarifa estándar de hora-hombre del técnico (la define Finanzas cada año).
Salida: Costo de mantenimiento por dron, base y mes (repuestos, consumibles, mano de obra, servicios externos) y horas de vuelo.
Precondición: Cierre contable del mes.
Errores: Sin tarifa vigente: la mano de obra se marca como pendiente.
Protocolo: Exportación CSV/Excel mensual.
No funcional: Mensual, al cierre contable.</documentation>
      <property key="Entrada" value="Tarifa estándar de hora-hombre del técnico (la define Finanzas cada año)."/>
      <property key="Salida" value="Costo de mantenimiento por dron, base y mes (repuestos, consumibles, mano de obra, servicios externos) y horas de vuelo."/>
      <property key="Precondición" value="Cierre contable del mes."/>
      <property key="No funcional" value="Mensual, al cierre contable."/>
      <property key="Errores" value="Sin tarifa vigente: la mano de obra se marca como pendiente."/>
      <property key="Protocolo" value="Exportación CSV/Excel mensual."/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato: Recibir avisos y gestionar garantías con fabricantes" id="ct-acs-fabricantes-soporte">
      <documentation>Entrada: Avisos técnicos y de firmware (modelo o rango de series, fecha límite); informes de reparación del taller.
Salida: Solicitud de garantía con el reporte de falla; registro de envío y regreso del equipo.
Precondición: Componente con garantía vigente (para garantías).
Errores: Aviso sin equipos afectados: se registra sin tareas. Regreso sin informe: el dron no se libera.
Protocolo: Correo/PDF registrado en el SGMF; envío físico por transportadora.
No funcional: El aviso genera tareas únicas obligatorias con fecha límite.</documentation>
      <property key="Entrada" value="Avisos técnicos y de firmware (modelo o rango de series, fecha límite); informes de reparación del taller."/>
      <property key="Salida" value="Solicitud de garantía con el reporte de falla; registro de envío y regreso del equipo."/>
      <property key="Precondición" value="Componente con garantía vigente (para garantías)."/>
      <property key="No funcional" value="El aviso genera tareas únicas obligatorias con fecha límite."/>
      <property key="Errores" value="Aviso sin equipos afectados: se registra sin tareas. Regreso sin informe: el dron no se libera."/>
      <property key="Protocolo" value="Correo/PDF registrado en el SGMF; envío físico por transportadora."/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato: Entregar evidencia a autoridades" id="ct-acs-autoridades">
      <documentation>Entrada: Requerimiento o visita de inspección de la Aerocivil o del ICA.
Salida: Libro de mantenimiento por dron, reportes de incidente, registros de calibración, altas y bajas de drones.
Precondición: Registros firmados.
Errores: Registros sin firma: se excluyen y se informa. Dron sin registro Aerocivil: alerta.
Protocolo: Documento PDF enviado por correo o trámite en línea (sin API).
No funcional: Disponible en minutos (hoy toma 2 días). Registros inmutables, conservados 5 años tras la baja.</documentation>
      <property key="Entrada" value="Requerimiento o visita de inspección de la Aerocivil o del ICA."/>
      <property key="Salida" value="Libro de mantenimiento por dron, reportes de incidente, registros de calibración, altas y bajas de drones."/>
      <property key="Precondición" value="Registros firmados."/>
      <property key="No funcional" value="Disponible en minutos (hoy toma 2 días). Registros inmutables, conservados 5 años tras la baja."/>
      <property key="Errores" value="Registros sin firma: se excluyen y se informa. Dron sin registro Aerocivil: alerta."/>
      <property key="Protocolo" value="Documento PDF enviado por correo o trámite en línea (sin API)."/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato: Entregar evidencia a aseguradora y clientes" id="ct-acs-aseguradora-clientes">
      <documentation>Entrada: Solicitud de la aseguradora (renovación o siniestro) o del cliente (auditoría GlobalG.A.P.).
Salida: Resumen anual de flota; historial completo del dron; constancia de mantenimiento y calibración vigente por dron o grupo.
Precondición: Registros firmados; datos de fincas protegidos (Ley 1581).
Errores: Dron con tareas vencidas o calibración vencida: la constancia no se emite.
Protocolo: PDF por correo (envío con un clic, deseable).
No funcional: Por demanda.</documentation>
      <property key="Entrada" value="Solicitud de la aseguradora (renovación o siniestro) o del cliente (auditoría GlobalG.A.P.)."/>
      <property key="Salida" value="Resumen anual de flota; historial completo del dron; constancia de mantenimiento y calibración vigente por dron o grupo."/>
      <property key="Precondición" value="Registros firmados; datos de fincas protegidos (Ley 1581)."/>
      <property key="No funcional" value="Por demanda."/>
      <property key="Errores" value="Dron con tareas vencidas o calibración vencida: la constancia no se emite."/>
      <property key="Protocolo" value="PDF por correo (envío con un clic, deseable)."/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato: Reportar baterías dadas de baja al gestor de residuos" id="ct-acs-residuos">
      <documentation>Entrada: Certificado de disposición del gestor de residuos.
Salida: Relación de baterías y filtros entregados; aviso a SST cuando una batería se retira por daño.
Precondición: Batería en estado retirada.
Errores: Batería no retirada: no se incluye en la relación.
Protocolo: Documento físico o correo registrado en el SGMF.
No funcional: Ocasional; prioridad por riesgo de incendio (SST).</documentation>
      <property key="Entrada" value="Certificado de disposición del gestor de residuos."/>
      <property key="Salida" value="Relación de baterías y filtros entregados; aviso a SST cuando una batería se retira por daño."/>
      <property key="Precondición" value="Batería en estado retirada."/>
      <property key="No funcional" value="Ocasional; prioridad por riesgo de incendio (SST)."/>
      <property key="Errores" value="Batería no retirada: no se incluye en la relación."/>
      <property key="Protocolo" value="Documento físico o correo registrado en el SGMF."/>
    </element>
    <element xsi:type="archimate:BusinessEvent" name="Piloto detecta falla en campo" id="bev-falla-campo"/>
    <element xsi:type="archimate:BusinessEvent" name="Fin de jornada de vuelo" id="bev-fin-jornada"/>
    <element xsi:type="archimate:BusinessEvent" name="Fabricante emite aviso técnico" id="bev-aviso"/>
    <element xsi:type="archimate:BusinessObject" name="Disponible con restricción" id="bo-lu-restr">
      <documentation>Estado en que el dron puede volar con una limitación conocida, por ejemplo por un diferimiento aprobado; el piloto debe verlo así en el prevuelo.</documentation>
      <property key="Contexto" value="Aeronavegabilidad y estado de flota"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Sinónimos" value="con restricción; dron restringido"/>
      <property key="Fuente" value="Entrevista §4: «El dron queda en estado “disponible con restricción” y el piloto debe verlo así en el prevuelo»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="En tierra" id="bo-lu-tierra">
      <documentation>Estado en que el dron no puede volar porque tiene una tarea vencida sin diferimiento o una falla reportada no resuelta.</documentation>
      <property key="Contexto" value="Aeronavegabilidad y estado de flota"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Sinónimos" value="en tierra por falla; dron parado; bloqueo"/>
      <property key="Fuente" value="Entrevista §3 reglas 11-12: «Un dron con una falla reportada no resuelta queda en tierra»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Fuera de servicio" id="bo-lu-fuera">
      <documentation>Estado de un dron que va a estar parado más de 7 días (por ejemplo, enviado al distribuidor por garantía); operaciones no lo cuenta en la programación.</documentation>
      <property key="Contexto" value="Aeronavegabilidad y estado de flota"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Sinónimos" value="—"/>
      <property key="Fuente" value="Entrevista §4: «si un dron va a estar parado más de 7 días… se marca como fuera de servicio»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Inspección prevuelo" id="bo-lu-prev">
      <documentation>Revisión que el piloto hace antes de cada jornada; si algún punto falla, el dron no vuela y se reporta la novedad.</documentation>
      <property key="Contexto" value="Aeronavegabilidad y estado de flota"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Sinónimos" value="prevuelo; formato FM-02"/>
      <property key="Fuente" value="Entrevista §3 regla 21: «Antes de cada jornada el piloto hace la inspección prevuelo; si algún punto falla, el dron no vuela»"/>
      <property key="Homónimo" value="«Inspección»: prevuelo del piloto (Aeronavegabilidad) vs inspección especial y verificación del inspector (Órdenes de trabajo)"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Liberación a servicio" id="bo-lu-lib">
      <documentation>Declaración firmada, después de cualquier mantenimiento, por un técnico con certificación vigente para el modelo, de que el dron queda disponible, disponible con restricción o continúa en tierra.</documentation>
      <property key="Contexto" value="Aeronavegabilidad y estado de flota"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Sinónimos" value="liberar el dron; liberación para vuelo; «este dron puede volar»"/>
      <property key="Fuente" value="Entrevista §3 regla 13: «el dron debe ser liberado a servicio por un técnico con certificación vigente para ese modelo»"/>
      <property key="Homónimo" value="«Servicio»: dron en operación (Aeronavegabilidad: liberación a servicio) vs paquete de tareas de mantenimiento (Planeación: servicio de 100 h, servicio mayor)"/>
    </element>
    <element xsi:type="archimate:BusinessEvent" name="Caída o aterrizaje brusco" id="ev-lu-caida">
      <documentation>Evento tras el cual el dron entra a inspección completa sin importar cómo se vea.</documentation>
      <property key="Contexto" value="Aeronavegabilidad y estado de flota"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Sinónimos" value="—"/>
      <property key="Fuente" value="Entrevista §3 regla 15: «Después de una caída o un aterrizaje brusco, el dron entra a inspección completa»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Tarea crítica" id="bo-lu-critica">
      <documentation>Tarea sobre motores, hélices, controladores de velocidad, controlador de vuelo o baterías; exige doble firma y no se puede diferir.</documentation>
      <property key="Contexto" value="Planeación del mantenimiento"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Sinónimos" value="crítica"/>
      <property key="Fuente" value="Entrevista §3 regla 14 y §4: «No se pueden diferir tareas críticas… Esas son absolutas»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Calibración de boquillas y caudal" id="bo-lu-calib">
      <documentation>Tarea que mide y ajusta el caudal y el tamaño de gota de las boquillas (50 h o 15 días); si está vencida, el agrónomo no autoriza la aplicación aunque el dron esté mecánicamente bien.</documentation>
      <property key="Contexto" value="Planeación del mantenimiento"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Sinónimos" value="calibración; formato FM-06"/>
      <property key="Fuente" value="Entrevista §3 regla 22: «La calibración de boquillas y caudal debe estar vigente para aplicar» | Inferencia: Ubicación en Planeación (como tarea) es inferencia; el resultado se registra en la orden de trabajo."/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Plan maestro de tareas" id="bo-lu-pmaestro">
      <documentation>Conjunto de tareas e intervalos por modelo que define y aprueba el jefe de mantenimiento; los cambios quedan registrados y aplican desde su fecha sin reescribir el pasado.</documentation>
      <property key="Contexto" value="Planeación del mantenimiento"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Sinónimos" value="matriz de mantenimiento; matriz maestra de tareas e intervalos; Excel maestro; MM-01"/>
      <property key="Fuente" value="Entrevista §6: «Es quien aprueba cambios en el plan maestro de tareas e intervalos»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Condición de mantenimiento" id="bo-lu-cond">
      <documentation>Criterio que hace exigible una tarea: por horas, por ciclos, por calendario o por estado (solo si una inspección o medición lo indica).</documentation>
      <property key="Contexto" value="Planeación del mantenimiento"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Sinónimos" value="condición; intervalo"/>
      <property key="Fuente" value="Entrevista §3 reglas 6 y 10: «por horas, por ciclos, por calendario o por estado (condición)»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Ajuste por base" id="bo-lu-ajuste">
      <documentation>Modificación del intervalo de ciertas tareas para una base; por ejemplo, Urabá al 80 % en filtros, bombas y boquillas.</documentation>
      <property key="Contexto" value="Planeación del mantenimiento"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Sinónimos" value="intervalo ajustado"/>
      <property key="Fuente" value="Entrevista §3 no escrita 2: «Nos gustaría que el intervalo de ciertas tareas se pudiera ajustar por base»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Paquete de servicio" id="bo-lu-paquete">
      <documentation>Agrupación de tareas que se ejecutan juntas para no abrir el dron por cada tarea suelta (servicio de 50 h, de 100 h, servicio mayor); al ejecutarlo se cumplen todas sus tareas.</documentation>
      <property key="Contexto" value="Planeación del mantenimiento"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Sinónimos" value="paquete; servicio de 50 h; servicio de 100 h"/>
      <property key="Fuente" value="Entrevista §8: «Las tareas se agrupan en paquetes (servicio de 50 h, de 100 h, servicio mayor)»"/>
      <property key="Homónimo" value="«Servicio»: dron en operación (Aeronavegabilidad: liberación a servicio) vs paquete de tareas de mantenimiento (Planeación: servicio de 100 h, servicio mayor)"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Servicio mayor" id="bo-lu-smayor">
      <documentation>Paquete que incluye todas las tareas de 100 h más desarme parcial; se hace a las 500 h o 12 meses y termina con vuelo de prueba sin carga.</documentation>
      <property key="Contexto" value="Planeación del mantenimiento"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Sinónimos" value="—"/>
      <property key="Fuente" value="Entrevista §8 matriz: «Servicio mayor (incluye todas las de 100 h + desarme parcial) 500 h o 12 meses»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Contador de la tarea" id="bo-lu-contador">
      <documentation>Uso o tiempo transcurrido desde la última ejecución de una tarea; se reinicia al cumplirla, al darla por cumplida en un correctivo o al reemplazar el componente.</documentation>
      <property key="Contexto" value="Planeación del mantenimiento"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Sinónimos" value="contador"/>
      <property key="Fuente" value="Entrevista §3 regla 7: «Cuando se ejecuta la tarea, su contador se reinicia desde ese momento» | Inferencia: Nombre compuesto propuesto para desambiguar «contador»."/>
      <property key="Homónimo" value="«Contador»: uso desde la última ejecución de una tarea (Planeación) vs acumulado de horas y ciclos del dron o componente (Configuración)"/>
    </element>
    <element xsi:type="archimate:BusinessEvent" name="Tarea vencida" id="ev-lu-evvenc">
      <documentation>La tarea alcanzó su intervalo sin ejecutarse; el dron no puede volar salvo diferimiento aprobado.</documentation>
      <property key="Contexto" value="Planeación del mantenimiento"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Sinónimos" value="mantenimiento vencido"/>
      <property key="Fuente" value="Entrevista §3 regla 11: «Un dron con alguna tarea preventiva vencida no puede volar, salvo que exista un diferimiento»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Aviso del fabricante" id="bo-lu-aviso">
      <documentation>Boletín de DJI o XAG que exige una acción sobre drones o componentes afectados (por modelo o rango de números de serie) con fecha límite.</documentation>
      <property key="Contexto" value="Planeación del mantenimiento"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Sinónimos" value="boletín; aviso técnico; actualización de firmware"/>
      <property key="Fuente" value="Entrevista §4: «a veces DJI o XAG emiten un aviso… Eso genera una tarea única y obligatoria»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Tarea única obligatoria" id="bo-lu-tunica">
      <documentation>Tarea que genera un aviso del fabricante sobre los equipos afectados; se ejecuta una sola vez antes de su fecha límite.</documentation>
      <property key="Contexto" value="Planeación del mantenimiento"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Sinónimos" value="—"/>
      <property key="Fuente" value="Entrevista §4: «genera una tarea única y obligatoria… con una fecha límite»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Ventana de mantenimiento" id="bo-lu-ventana">
      <documentation>Periodo en que un dron está programado para entrar a taller; se informa a Programación de servicios.</documentation>
      <property key="Contexto" value="Planeación del mantenimiento"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Sinónimos" value="—"/>
      <property key="Fuente" value="Entrevista §9 (47): «ventanas de mantenimiento programadas»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Proyección a 30 días" id="bo-lu-proy">
      <documentation>Estimación de los mantenimientos que vienen, según el ritmo de vuelo de cada dron, y de los repuestos que harán falta por base.</documentation>
      <property key="Contexto" value="Planeación del mantenimiento"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Sinónimos" value="proyección de mantenimientos; proyección de repuestos"/>
      <property key="Fuente" value="Entrevista §5: «Una proyección a 30 días… y qué repuestos van a hacer falta por base. Esto para mí es el indicador más valioso»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Modelo" id="bo-lu-modelo">
      <documentation>Tipo de dron (T40, T50, P100) que determina las tareas e intervalos y para el que se habilita a pilotos y técnicos.</documentation>
      <property key="Contexto" value="Configuración de flota y vida de componentes"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Sinónimos" value="modelo de dron"/>
      <property key="Fuente" value="Entrevista §3 regla 24: «Solo un técnico certificado para el modelo puede ejecutar y firmar»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Base" id="bo-lu-base">
      <documentation>Base operativa (Rionegro, Apartadó, El Espinal; Meta desde 2027) donde está hoy el dron; las baterías le pertenecen.</documentation>
      <property key="Contexto" value="Configuración de flota y vida de componentes"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Sinónimos" value="base operativa; sede"/>
      <property key="Fuente" value="Entrevista §1: «1 sede administrativa + 3 bases operativas»; §9: «crear una base nueva con sus bodegas, drones y personal»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Despiece" id="bo-lu-despiece">
      <documentation>Estructura de cada dron en subsistemas y componentes, con las condiciones de mantenimiento de cada pieza.</documentation>
      <property key="Contexto" value="Configuración de flota y vida de componentes"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Sinónimos" value="configuración; subsistemas"/>
      <property key="Fuente" value="Entrevista Alcance: «Despiece de cada dron (subsistemas y componentes como motores, hélices, baterías, bombas y boquillas)»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Posición" id="bo-lu-posicion">
      <documentation>Lugar del despiece donde se instala un componente; las hélices se controlan por juego y por posición.</documentation>
      <property key="Contexto" value="Configuración de flota y vida de componentes"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Sinónimos" value="posición de instalación (modelo)"/>
      <property key="Fuente" value="Entrevista §8: «Las hélices se controlan por juego y por posición»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Juego de hélices" id="bo-lu-helices">
      <documentation>Hélices del mismo eje que se cambian juntas aunque solo una esté dañada; no tienen número de serie pero se marcan.</documentation>
      <property key="Contexto" value="Configuración de flota y vida de componentes"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Sinónimos" value="juego"/>
      <property key="Fuente" value="Entrevista §3 no escrita 1: «Las hélices se cambian por juego del mismo eje»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Configuración instalada" id="bo-lu-configinst">
      <documentation>Componentes controlados que un dron tiene montados hoy, con su número de serie y el historial de instalaciones y desmontajes.</documentation>
      <property key="Contexto" value="Configuración de flota y vida de componentes"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Sinónimos" value="componentes instalados"/>
      <property key="Fuente" value="Entrevista §6 libro (3): «Configuración instalada: qué componentes controlados tiene montados hoy»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Movimiento de componente" id="bo-lu-movim">
      <documentation>Instalación o desmontaje de un componente entre drones o hacia el almacén, con motivo (vencimiento, falla o canibalización), sin perder su historia.</documentation>
      <property key="Contexto" value="Configuración de flota y vida de componentes"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Sinónimos" value="cambio de componente; instalación; desmontaje"/>
      <property key="Fuente" value="Entrevista §8: «Componentes desmontados e instalados, con número de serie y motivo (vencimiento, falla, canibalización)»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Canibalización" id="bo-lu-canib">
      <documentation>Sacar un componente de un dron que ya está parado por otra razón para instalarlo en otro; la autoriza el jefe de mantenimiento y queda como movimiento.</documentation>
      <property key="Contexto" value="Configuración de flota y vida de componentes"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Sinónimos" value="—"/>
      <property key="Fuente" value="Entrevista §4: «el jefe de mantenimiento puede autorizar canibalización… Esto debe quedar registrado como movimiento del componente»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Acumulado de horas y ciclos" id="bo-lu-acum">
      <documentation>Horas y ciclos que suman el dron y cada componente controlado instalado; el componente se lleva su acumulado al cambiar de dron.</documentation>
      <property key="Contexto" value="Configuración de flota y vida de componentes"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Sinónimos" value="acumulado; contadores (modelo y §4)"/>
      <property key="Fuente" value="Entrevista §3 regla 4: «Si el componente se pasa a otro dron, se lleva su acumulado»"/>
      <property key="Homónimo" value="«Contador»: uso desde la última ejecución de una tarea (Planeación) vs acumulado de horas y ciclos del dron o componente (Configuración)"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Ciclo de batería" id="bo-lu-cicbat">
      <documentation>Una descarga en vuelo y su recarga; lo cuenta la propia batería y se ve en la app del fabricante.</documentation>
      <property key="Contexto" value="Configuración de flota y vida de componentes"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Sinónimos" value="ciclo"/>
      <property key="Fuente" value="Entrevista §3 regla 3: «Un ciclo de batería es una descarga en vuelo y su recarga»"/>
      <property key="Homónimo" value="«Ciclo»: despegue-aterrizaje del dron (Registro de uso) vs descarga-recarga de la batería (Configuración)"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Salud de batería" id="bo-lu-salud">
      <documentation>Porcentaje de estado reportado por la batería; por debajo del 80 % se retira.</documentation>
      <property key="Contexto" value="Configuración de flota y vida de componentes"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Sinónimos" value="salud reportada"/>
      <property key="Fuente" value="Entrevista §3 regla 16: «cuando su salud reportada baja del 80 %»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Cuarentena" id="bo-lu-cuar">
      <documentation>Estado de una batería con golpe, hinchazón o recalentamiento; no vuelve a vuelo sin evaluación.</documentation>
      <property key="Contexto" value="Configuración de flota y vida de componentes"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Sinónimos" value="estante con cinta roja (práctica actual)"/>
      <property key="Fuente" value="Entrevista §3 regla 19: «Una batería con golpe, hinchazón o recalentamiento queda en cuarentena»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Baja" id="bo-lu-baja">
      <documentation>Retiro definitivo: de un dron completo (solo gerencia), de un componente (solo el jefe de mantenimiento) o de una batería (1.000 ciclos o salud &lt; 80 %).</documentation>
      <property key="Contexto" value="Configuración de flota y vida de componentes"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Sinónimos" value="dado de baja; retiro (baterías)"/>
      <property key="Fuente" value="Entrevista §6: «solo el jefe de mantenimiento da de baja un componente; solo gerencia da de baja un dron completo»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Traslado de dron" id="bo-lu-trasdron">
      <documentation>Cambio de base de un dron por picos de demanda o para mantenimiento en Rionegro; su ubicación actual cambia.</documentation>
      <property key="Contexto" value="Configuración de flota y vida de componentes"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Sinónimos" value="traslado"/>
      <property key="Fuente" value="Entrevista §1: «cuando hay picos, trasladamos drones entre bases» | Inferencia: Calificativo «de dron» propuesto para desambiguar."/>
      <property key="Homónimo" value="«Traslado»: dron que cambia de base (Configuración) vs repuestos que pasan de una bodega a otra (Abastecimiento)"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Garantía" id="bo-lu-garantia">
      <documentation>Periodo en que un componente que falla se gestiona con el distribuidor en lugar de cambiarse con stock propio.</documentation>
      <property key="Contexto" value="Configuración de flota y vida de componentes"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Sinónimos" value="componente en garantía"/>
      <property key="Fuente" value="Entrevista §4: «Necesitamos saber qué componentes están en garantía y hasta cuándo»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Hora de vuelo" id="bo-lu-hora">
      <documentation>Tiempo en el aire, desde que el dron despega hasta que aterriza; no cuenta el motor encendido en tierra.</documentation>
      <property key="Contexto" value="Registro de uso"/>
      <property key="Clasificación" value="Soporte"/>
      <property key="Sinónimos" value="horas"/>
      <property key="Fuente" value="Entrevista §3 regla 1: «Una hora de vuelo se cuenta desde que despega hasta que aterriza»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Ciclo de dron" id="bo-lu-cicdron">
      <documentation>Un despegue y un aterrizaje; cada salida de aspersión es un ciclo.</documentation>
      <property key="Contexto" value="Registro de uso"/>
      <property key="Clasificación" value="Soporte"/>
      <property key="Sinónimos" value="ciclo; salida"/>
      <property key="Fuente" value="Entrevista §3 regla 2: «Un ciclo de dron es un despegue y un aterrizaje»"/>
      <property key="Homónimo" value="«Ciclo»: despegue-aterrizaje del dron (Registro de uso) vs descarga-recarga de la batería (Configuración)"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Bitácora de vuelo" id="bo-lu-bitac">
      <documentation>Reporte del piloto al cierre de jornada con horas, ciclos, hectáreas y novedades.</documentation>
      <property key="Contexto" value="Registro de uso"/>
      <property key="Clasificación" value="Soporte"/>
      <property key="Sinónimos" value="formato FM-01; reporte manual"/>
      <property key="Fuente" value="Entrevista §2 paso 7: «el piloto llena la bitácora de vuelo… con horas, ciclos, hectáreas y novedades»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Exportación del fabricante" id="bo-lu-export">
      <documentation>Archivo CSV o Excel con los registros de vuelo que el coordinador descarga de la plataforma DJI o XAG y sube al sistema; cada fabricante con sus propias columnas.</documentation>
      <property key="Contexto" value="Registro de uso"/>
      <property key="Clasificación" value="Soporte"/>
      <property key="Sinónimos" value="archivo exportado; Lote de importación (modelo)"/>
      <property key="Fuente" value="Entrevista §9: «ambas plataformas permiten exportar los registros a archivo (CSV o Excel)… cada una con columnas… distintos»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Inconsistencia" id="bo-lu-incons">
      <documentation>Registro señalado al cargar: dron que no existe, vuelo que se cruza en hora con otro del mismo dron o duración absurda.</documentation>
      <property key="Contexto" value="Registro de uso"/>
      <property key="Clasificación" value="Soporte"/>
      <property key="Sinónimos" value="—"/>
      <property key="Fuente" value="Entrevista §9: «señalando inconsistencias (dron que no existe, vuelo que se cruza… duración absurda)»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Corrección con motivo" id="bo-lu-correc">
      <documentation>Ajuste de un registro equivocado que no lo borra: deja rastro del original y recalcula los contadores.</documentation>
      <property key="Contexto" value="Registro de uso"/>
      <property key="Clasificación" value="Soporte"/>
      <property key="Sinónimos" value="corrección"/>
      <property key="Fuente" value="Entrevista §4: «no se debería borrar, sino hacer una corrección con motivo y que se recalculen los contadores»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Reconciliación" id="bo-lu-recon">
      <documentation>Cuando la exportación llega después de un reporte manual del piloto, prima el dato del fabricante y el ajuste queda marcado.</documentation>
      <property key="Contexto" value="Registro de uso"/>
      <property key="Clasificación" value="Soporte"/>
      <property key="Sinónimos" value="ajuste"/>
      <property key="Fuente" value="Entrevista §9: «Reconciliación: si el piloto reportó horas manualmente… debe primar el dato del fabricante»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Correctivo" id="bo-lu-correct">
      <documentation>Mantenimiento para resolver una falla; tiene prioridad sobre el preventivo y exige registrar la causa de la falla con una categoría.</documentation>
      <property key="Contexto" value="Órdenes de trabajo"/>
      <property key="Clasificación" value="Soporte"/>
      <property key="Sinónimos" value="mantenimiento correctivo; orden correctiva"/>
      <property key="Fuente" value="Entrevista §4: «Un correctivo siempre tiene prioridad sobre el preventivo»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Inspección especial" id="bo-lu-inspesp">
      <documentation>Orden fuera del plan: inspección completa tras caída o aterrizaje brusco, o inspección de recibo al regresar de taller externo.</documentation>
      <property key="Contexto" value="Órdenes de trabajo"/>
      <property key="Clasificación" value="Soporte"/>
      <property key="Sinónimos" value="inspección completa; inspección de recibo"/>
      <property key="Fuente" value="Entrevista §8: «inspección especial (post-caída, recibo de taller externo)»"/>
      <property key="Homónimo" value="«Inspección»: prevuelo del piloto (Aeronavegabilidad) vs inspección especial y verificación del inspector (Órdenes de trabajo)"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Checklist" id="bo-lu-check">
      <documentation>Lista de tareas de la orden, cada una con resultado conforme, no conforme o no aplica.</documentation>
      <property key="Contexto" value="Órdenes de trabajo"/>
      <property key="Clasificación" value="Soporte"/>
      <property key="Sinónimos" value="formato FM-05 (servicio de 100 h)"/>
      <property key="Fuente" value="Entrevista §8: «Checklist de cada tarea con resultado: conforme / no conforme / no aplica»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Valor medido" id="bo-lu-valor">
      <documentation>Medición registrada en una tarea (caudal en L/min, salud de batería en %, temperatura del motor); fuera de rango deja la tarea no conforme.</documentation>
      <property key="Contexto" value="Órdenes de trabajo"/>
      <property key="Clasificación" value="Soporte"/>
      <property key="Sinónimos" value="medición"/>
      <property key="Fuente" value="Entrevista §8: «para algunas tareas un valor medido (por ejemplo, caudal de la boquilla en L/min…)»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Tarea no conforme" id="bo-lu-noconf">
      <documentation>Tarea cuyo resultado o valor medido no cumple; debe generar una acción.</documentation>
      <property key="Contexto" value="Órdenes de trabajo"/>
      <property key="Clasificación" value="Soporte"/>
      <property key="Sinónimos" value="no conforme"/>
      <property key="Fuente" value="Entrevista §8: «Si un valor medido está fuera de rango, la tarea queda no conforme y debe generar una acción»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Hallazgo" id="bo-lu-hallazgo">
      <documentation>Observación en texto libre, con fotos, registrada en la intervención, sobre todo de daños y de tareas críticas.</documentation>
      <property key="Contexto" value="Órdenes de trabajo"/>
      <property key="Clasificación" value="Soporte"/>
      <property key="Sinónimos" value="—"/>
      <property key="Fuente" value="Entrevista §8: «Hallazgos en texto libre y fotos»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Doble firma" id="bo-lu-dfirma">
      <documentation>Firma del técnico que ejecuta más la de un técnico inspector distinto que verifica; obligatoria en tareas críticas.</documentation>
      <property key="Contexto" value="Órdenes de trabajo"/>
      <property key="Clasificación" value="Soporte"/>
      <property key="Sinónimos" value="segunda firma"/>
      <property key="Fuente" value="Entrevista §3 regla 14: «requieren doble firma: el técnico que ejecuta y un técnico inspector distinto que verifica»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Inspección remota" id="bo-lu-iremota">
      <documentation>Verificación de una tarea crítica por un inspector de otra base a partir de evidencia fotográfica, cuando en la base hay un solo técnico.</documentation>
      <property key="Contexto" value="Órdenes de trabajo"/>
      <property key="Clasificación" value="Soporte"/>
      <property key="Sinónimos" value="firma por teléfono (práctica actual)"/>
      <property key="Fuente" value="Entrevista §3 no escrita 4: «Queremos que esto quede registrado como inspección remota con evidencia fotográfica»"/>
      <property key="Homónimo" value="«Inspección»: prevuelo del piloto (Aeronavegabilidad) vs inspección especial y verificación del inspector (Órdenes de trabajo)"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Horas-hombre" id="bo-lu-hh">
      <documentation>Tiempo de trabajo de cada técnico en la orden; base del costo de mano de obra.</documentation>
      <property key="Contexto" value="Órdenes de trabajo"/>
      <property key="Clasificación" value="Soporte"/>
      <property key="Sinónimos" value="mano de obra"/>
      <property key="Fuente" value="Entrevista §8: «Horas-hombre por técnico»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Categoría de falla" id="bo-lu-catfalla">
      <documentation>Clasificación de la causa de una falla: motor, hélice, controlador de velocidad, bomba, boquilla, batería, GPS/RTK, radar, estructura, software/firmware, error de operación o causa externa.</documentation>
      <property key="Contexto" value="Órdenes de trabajo"/>
      <property key="Clasificación" value="Soporte"/>
      <property key="Sinónimos" value="causa de la falla"/>
      <property key="Fuente" value="Entrevista §4: «Todo correctivo debe registrar la causa de la falla con una categoría»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Informe del taller" id="bo-lu-informe">
      <documentation>Documento con el que regresa el equipo del taller externo; sin él no pasa la inspección de recibo ni se libera.</documentation>
      <property key="Contexto" value="Órdenes de trabajo"/>
      <property key="Clasificación" value="Soporte"/>
      <property key="Sinónimos" value="informe de reparación"/>
      <property key="Fuente" value="Entrevista §4: «Dron que regresa de taller externo: debe entrar con su informe»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Repuesto" id="bo-lu-repuesto">
      <documentation>Pieza que se usa en un cambio; Siigo es dueño de su existencia y costo, y Mantenimiento de qué repuesto requiere cada tarea.</documentation>
      <property key="Contexto" value="Abastecimiento de repuestos"/>
      <property key="Clasificación" value="Soporte"/>
      <property key="Sinónimos" value="—"/>
      <property key="Fuente" value="Entrevista §9: «el sistema de mantenimiento es el dueño de qué repuesto requiere cada tarea»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Consumible" id="bo-lu-consumible">
      <documentation>Pieza sin vida individual (filtros, tornillería, sellos, discos): solo se registra que se cambió y cuántos se usaron.</documentation>
      <property key="Contexto" value="Abastecimiento de repuestos"/>
      <property key="Clasificación" value="Soporte"/>
      <property key="Sinónimos" value="—"/>
      <property key="Fuente" value="Entrevista §8: «Filtros, tornillería, sellos y discos son consumibles: no se les sigue la vida individual»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Existencia" id="bo-lu-exist">
      <documentation>Cantidad disponible de un repuesto en la bodega de una base, según Siigo.</documentation>
      <property key="Contexto" value="Abastecimiento de repuestos"/>
      <property key="Clasificación" value="Soporte"/>
      <property key="Sinónimos" value="existencias; stock"/>
      <property key="Fuente" value="Entrevista §9: «Siigo es el dueño de las existencias y del costo»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Bodega" id="bo-lu-bodega">
      <documentation>Almacén de repuestos de una base; en Siigo hay una bodega por base.</documentation>
      <property key="Contexto" value="Abastecimiento de repuestos"/>
      <property key="Clasificación" value="Soporte"/>
      <property key="Sinónimos" value="almacén"/>
      <property key="Fuente" value="Entrevista §2: «Siigo Nube (módulo de inventario, una bodega por base)»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Consumo de repuesto" id="bo-lu-consumo">
      <documentation>Repuestos y consumibles usados en una orden, con cantidades; se registra al cerrarla.</documentation>
      <property key="Contexto" value="Abastecimiento de repuestos"/>
      <property key="Clasificación" value="Soporte"/>
      <property key="Sinónimos" value="consumo; salida de inventario (Siigo y modelo)"/>
      <property key="Fuente" value="Entrevista §9 (47): «consumos reales… consumos al cerrarla»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Faltante" id="bo-lu-faltante">
      <documentation>Repuesto que no hay en la bodega para una orden o que hará falta según la proyección.</documentation>
      <property key="Contexto" value="Abastecimiento de repuestos"/>
      <property key="Clasificación" value="Soporte"/>
      <property key="Sinónimos" value="faltante proyectado"/>
      <property key="Fuente" value="Entrevista §9 (47): «al almacenista cuando hay faltantes proyectados»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Necesidad proyectada" id="bo-lu-necesidad">
      <documentation>Repuestos que harán falta por base según la proyección de mantenimientos.</documentation>
      <property key="Contexto" value="Abastecimiento de repuestos"/>
      <property key="Clasificación" value="Soporte"/>
      <property key="Sinónimos" value="necesidades futuras de repuestos"/>
      <property key="Fuente" value="Entrevista §9 (47): «Necesidades proyectadas por base»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Solicitud de compra" id="bo-lu-scompra">
      <documentation>Pedido de compra que se genera cuando la proyección muestra faltantes; la compra la hace Almacén en Siigo.</documentation>
      <property key="Contexto" value="Abastecimiento de repuestos"/>
      <property key="Clasificación" value="Soporte"/>
      <property key="Sinónimos" value="orden de compra (Siigo)"/>
      <property key="Fuente" value="Entrevista §9: «generar solicitudes de compra o de traslado cuando la proyección muestra faltantes»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Traslado de repuestos" id="bo-lu-trasrep">
      <documentation>Envío de repuestos desde la bodega de otra base (1 a 2 días por transportadora).</documentation>
      <property key="Contexto" value="Abastecimiento de repuestos"/>
      <property key="Clasificación" value="Soporte"/>
      <property key="Sinónimos" value="traslado; solicitud de traslado"/>
      <property key="Fuente" value="Entrevista §4: «el almacén revisa si hay en otra base y lo traslada (1 a 2 días por transportadora)» | Inferencia: Calificativo «de repuestos» propuesto para desambiguar."/>
      <property key="Homónimo" value="«Traslado»: dron que cambia de base (Configuración) vs repuestos que pasan de una bodega a otra (Abastecimiento)"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Certificación" id="bo-lu-cert">
      <documentation>Acreditación de un piloto o técnico con tipo, modelos habilitados, fecha de expedición y vencimiento; la lleva Talento humano.</documentation>
      <property key="Contexto" value="Personal habilitado"/>
      <property key="Clasificación" value="Genérico"/>
      <property key="Sinónimos" value="certificado"/>
      <property key="Fuente" value="Entrevista §9: «persona, rol, tipo de certificación, modelos habilitados, fecha de expedición y vencimiento»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Vencimiento de certificación" id="bo-lu-vcert">
      <documentation>Fecha en que una certificación deja de estar vigente; sin vigencia no se vuela ni se firma.</documentation>
      <property key="Contexto" value="Personal habilitado"/>
      <property key="Clasificación" value="Genérico"/>
      <property key="Sinónimos" value="certificado vencido"/>
      <property key="Fuente" value="Entrevista §2: «Un piloto con certificado vencido no puede volar, y un técnico sin certificación vigente no debería firmar»"/>
      <property key="Homónimo" value="«Vencimiento»: de una tarea preventiva (Planeación) vs de una certificación de personal (Personal habilitado)"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Hoja de vida del dron" id="bo-lu-hvida">
      <documentation>Datos básicos del dron: modelo, número de serie, registro ante Aerocivil, fecha de adquisición, estado y base.</documentation>
      <property key="Contexto" value="Indicadores y reportes"/>
      <property key="Clasificación" value="Genérico"/>
      <property key="Sinónimos" value="carpeta del dron"/>
      <property key="Fuente" value="Entrevista §6: «Hoja de vida del dron: modelo, número de serie, registro ante Aerocivil, fecha de adquisición, estado, base»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Constancia de mantenimiento y calibración" id="bo-lu-const">
      <documentation>Documento por dron o grupo de drones que certifica mantenimiento y calibración vigentes; lo piden los clientes certificados.</documentation>
      <property key="Contexto" value="Indicadores y reportes"/>
      <property key="Clasificación" value="Genérico"/>
      <property key="Sinónimos" value="constancia"/>
      <property key="Fuente" value="Entrevista §9: «Constancia de mantenimiento y calibración vigente por dron o por grupo de drones, para clientes»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Resumen del estado de la flota" id="bo-lu-resumen">
      <documentation>Documento para la renovación anual de la póliza con la aseguradora.</documentation>
      <property key="Contexto" value="Indicadores y reportes"/>
      <property key="Clasificación" value="Genérico"/>
      <property key="Sinónimos" value="—"/>
      <property key="Fuente" value="Entrevista §9: «Resumen del estado de la flota para la renovación de la póliza»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Reporte de incidente" id="bo-lu-rincid">
      <documentation>Documento con los datos del dron, la falla y la intervención, para Aerocivil o aseguradora.</documentation>
      <property key="Contexto" value="Indicadores y reportes"/>
      <property key="Clasificación" value="Genérico"/>
      <property key="Sinónimos" value="—"/>
      <property key="Fuente" value="Entrevista §9: «Reporte de incidente con los datos del dron, la falla y la intervención»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Indicador de mantenimiento" id="bo-lu-indic">
      <documentation>Medida del desempeño del proceso por base, modelo y periodo; se revisa mensualmente con gerencia.</documentation>
      <property key="Contexto" value="Indicadores y reportes"/>
      <property key="Clasificación" value="Genérico"/>
      <property key="Sinónimos" value="indicador; KPI; métrica"/>
      <property key="Fuente" value="Entrevista §5: «¿Qué métricas usan para saber si el proceso funciona bien?» | Inferencia: Término genérico propuesto para agrupar los indicadores."/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Indicador de disponibilidad" id="bo-lu-idisp">
      <documentation>Días-dron disponibles (incluye disponible con restricción) / días-dron totales del periodo, sin drones dados de baja; meta ≥ 90 %.</documentation>
      <property key="Contexto" value="Indicadores y reportes"/>
      <property key="Clasificación" value="Genérico"/>
      <property key="Sinónimos" value="disponibilidad de la flota"/>
      <property key="Fuente" value="Entrevista §5 tabla: «Disponibilidad de la flota: Días-dron disponibles… / días-dron totales» | Inferencia: Nombre propuesto para desambiguar «disponibilidad»."/>
      <property key="Homónimo" value="«Disponibilidad»: estado de cada dron por día para Programación (Aeronavegabilidad) vs indicador del periodo (Indicadores)"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Cumplimiento del plan preventivo" id="bo-lu-icumpl">
      <documentation>Tareas preventivas ejecutadas antes de vencer / tareas que vencían en el periodo; meta ≥ 95 %.</documentation>
      <property key="Contexto" value="Indicadores y reportes"/>
      <property key="Clasificación" value="Genérico"/>
      <property key="Sinónimos" value="—"/>
      <property key="Fuente" value="Entrevista §5 tabla"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Tiempo medio entre fallas (MTBF)" id="bo-lu-mtbf">
      <documentation>Horas de vuelo / número de fallas no planeadas, por modelo y por tipo de componente.</documentation>
      <property key="Contexto" value="Indicadores y reportes"/>
      <property key="Clasificación" value="Genérico"/>
      <property key="Sinónimos" value="MTBF"/>
      <property key="Fuente" value="Entrevista §5 tabla"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Tiempo medio de reparación (MTTR)" id="bo-lu-mttr">
      <documentation>Promedio de horas desde que el dron queda en tierra por falla hasta que se libera; meta ≤ 24 h en fallas menores.</documentation>
      <property key="Contexto" value="Indicadores y reportes"/>
      <property key="Clasificación" value="Genérico"/>
      <property key="Sinónimos" value="MTTR"/>
      <property key="Fuente" value="Entrevista §5 tabla"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Costo de mantenimiento por hora de vuelo" id="bo-lu-costo">
      <documentation>(Repuestos + consumibles + mano de obra + servicios externos) / horas de vuelo, por dron, modelo, base y mes; meta ≤ 80.000 COP/h.</documentation>
      <property key="Contexto" value="Indicadores y reportes"/>
      <property key="Clasificación" value="Genérico"/>
      <property key="Sinónimos" value="costo por hora"/>
      <property key="Fuente" value="Entrevista §5 tabla"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Backlog de mantenimiento" id="bo-lu-backlog">
      <documentation>Tareas pendientes vencidas o próximas a vencer.</documentation>
      <property key="Contexto" value="Indicadores y reportes"/>
      <property key="Clasificación" value="Genérico"/>
      <property key="Sinónimos" value="backlog"/>
      <property key="Fuente" value="Entrevista §5 tabla: «Backlog de mantenimiento: Tareas pendientes vencidas o próximas a vencer»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Usuario" id="bo-lu-usuario">
      <documentation>Persona con cuenta individual, idealmente su cuenta de Google, y un rol con permisos; nada de usuarios compartidos por base.</documentation>
      <property key="Contexto" value="Identidad y notificaciones"/>
      <property key="Clasificación" value="Genérico"/>
      <property key="Sinónimos" value="cuenta"/>
      <property key="Fuente" value="Entrevista §7: «usuarios individuales con roles (nada de usuarios compartidos por base)»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Firma digital sencilla" id="bo-lu-fdigital">
      <documentation>Usuario autenticado más confirmación, con registro de quién firmó y cuándo; reemplaza la firma en papel.</documentation>
      <property key="Contexto" value="Identidad y notificaciones"/>
      <property key="Clasificación" value="Genérico"/>
      <property key="Sinónimos" value="firma"/>
      <property key="Fuente" value="Entrevista §3: «que las firmas pasen a ser firmas digitales sencillas (usuario autenticado + confirmación)»"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Trazabilidad" id="bo-lu-traza">
      <documentation>Registro de usuario, fecha, hora y base de toda acción importante; nada se borra y las correcciones dejan rastro.</documentation>
      <property key="Contexto" value="Identidad y notificaciones"/>
      <property key="Clasificación" value="Genérico"/>
      <property key="Sinónimos" value="rastro; auditoría"/>
      <property key="Fuente" value="Entrevista §6: «Trazabilidad completa: toda acción importante… debe quedar con usuario, fecha y hora, y base» | Inferencia: Ubicación en este contexto: inferencia (el modelo lo tiene como servicio de infraestructura)."/>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Talento humano y SST" id="act-sst">
      <documentation>Área que lleva las certificaciones del personal y la seguridad y salud en el trabajo; debe saber cuándo se retira una batería por daño (riesgo de incendio) para gestionar su disposición.</documentation>
      <property key="Contexto" value="Contraparte fuera del SGMF"/>
      <property key="Clasificación" value="Proceso interno"/>
      <property key="Patrón" value="Conformista"/>
      <property key="Fuente" value="§2 tabla de áreas: «Talento humano y SST»; §9 [V]: «cuando se retira una batería por daño… SST necesita saberlo»"/>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Distribuidores DJI y XAG (taller externo)" id="act-dist">
      <documentation>Distribuidores autorizados en Bogotá que emiten avisos técnicos y de firmware y reparan o reemplazan equipos en garantía.</documentation>
      <property key="Contexto" value="Contraparte fuera del SGMF"/>
      <property key="Clasificación" value="Proveedor"/>
      <property key="Patrón" value="Capa anticorrupción (ACL)"/>
      <property key="Fuente" value="§9: «Fabricantes y distribuidores autorizados… funcionan como taller externo para garantías y reparaciones mayores»"/>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Gestor de residuos peligrosos" id="act-gestor">
      <documentation>Empresa que recoge baterías dadas de baja y filtros contaminados y entrega el certificado de disposición.</documentation>
      <property key="Contexto" value="Contraparte fuera del SGMF"/>
      <property key="Clasificación" value="Proveedor"/>
      <property key="Patrón" value="Conformista"/>
      <property key="Fuente" value="§9: «Gestor de residuos peligrosos, que recoge baterías dadas de baja y filtros contaminados»"/>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Aerocivil" id="act-aerocivil">
      <documentation>Autoridad aeronáutica (RAC 100): registra drones, recibe reportes de incidentes e inspecciona registros de mantenimiento sin fecha fija.</documentation>
      <property key="Contexto" value="Contraparte fuera del SGMF"/>
      <property key="Clasificación" value="Entidad regulatoria"/>
      <property key="Patrón" value="Conformista"/>
      <property key="Fuente" value="§6: «los drones están regulados por la Aerocivil, mediante el RAC 100»; §9 tabla de entidades"/>
    </element>
    <element xsi:type="archimate:BusinessActor" name="ICA" id="act-ica">
      <documentation>Autoridad agrícola: verifica a la empresa aplicadora y pide los registros de calibración en sus visitas.</documentation>
      <property key="Contexto" value="Contraparte fuera del SGMF"/>
      <property key="Clasificación" value="Entidad regulatoria"/>
      <property key="Patrón" value="Conformista"/>
      <property key="Fuente" value="§6: «el ICA regula la aplicación de plaguicidas»; §9: «ICA: Registros de calibración cuando hay visita»"/>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Aseguradora de la flota" id="act-aseg">
      <documentation>Aseguradora de la póliza todo riesgo y de responsabilidad civil; pide el resumen anual de la flota y, en siniestro, el historial completo del dron.</documentation>
      <property key="Contexto" value="Contraparte fuera del SGMF"/>
      <property key="Clasificación" value="Entidad externa"/>
      <property key="Patrón" value="Conformista"/>
      <property key="Fuente" value="§6: «Aseguradora: en la renovación anual… piden un resumen… y en caso de siniestro… el historial completo»"/>
    </element>
    <element xsi:type="archimate:Representation" name="Tablero de estado de la flota" id="rp-estado">
      <documentation>Forma en que se ve o se registra «Estado de aeronavegabilidad» (deseado (sgmf)).</documentation>
      <property key="Contexto" value="Aeronavegabilidad y estado de flota"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Sinónimos" value="Ninguno"/>
      <property key="Momento" value="Deseado (SGMF)"/>
      <property key="Fuente" value="§5 [V]: «Un tablero de estado de la flota en tiempo casi real»"/>
    </element>
    <element xsi:type="archimate:Representation" name="Formato FM-02 de inspección prevuelo (papel)" id="rp-lu-prev">
      <documentation>Forma en que se ve o se registra «Inspección prevuelo» (actual).</documentation>
      <property key="Contexto" value="Aeronavegabilidad y estado de flota"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Sinónimos" value="Ninguno"/>
      <property key="Momento" value="Actual"/>
      <property key="Fuente" value="§2: «Inspección prevuelo — Papel en todas las bases (formato FM-02)»"/>
    </element>
