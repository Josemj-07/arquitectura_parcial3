    <element xsi:type="archimate:RealizationRelationship" name="ofrece" id="r-bc-116" source="ac-indicadores" target="svc-ind-costos">
      <documentation>Contexto Indicadores y reportes ofrece el servicio «Exportar costos de mantenimiento».</documentation>
      <property key="Canvas" value="Comunicación saliente (consultas y documentos)"/>
      <property key="Fuente" value="Derivada de V8/V9: el contexto se compone de la interfaz que tiene asignado el servicio"/>
    </element>
    <element xsi:type="archimate:AssociationRelationship" name="significa" id="r-lu2-001" source="bo-estado" target="mn-estado">
      <documentation>El término «Estado de aeronavegabilidad» significa: Responde «¿este dron puede volar hoy?» y con qué motivo.</documentation>
      <property key="Fuente" value="V7: término del glosario y su definición o su forma de registro en la entrevista"/>
    </element>
    <element xsi:type="archimate:AssociationRelationship" name="significa" id="r-lu2-002" source="bo-lu-prev" target="mn-lu-prev">
      <documentation>El término «Inspección prevuelo» significa: Revisión del piloto antes de cada jornada; si un punto falla, el dron no vuela.</documentation>
      <property key="Fuente" value="V7: término del glosario y su definición o su forma de registro en la entrevista"/>
    </element>
    <element xsi:type="archimate:AssociationRelationship" name="significa" id="r-lu2-003" source="bo-lu-pmaestro" target="mn-lu-pmaestro">
      <documentation>El término «Plan maestro de tareas» significa: Tareas e intervalos por modelo que define y aprueba el jefe de mantenimiento.</documentation>
      <property key="Fuente" value="V7: término del glosario y su definición o su forma de registro en la entrevista"/>
    </element>
    <element xsi:type="archimate:AssociationRelationship" name="significa" id="r-lu2-004" source="bo-lu-calib" target="mn-lu-calib">
      <documentation>El término «Calibración de boquillas y caudal» significa: Medición y ajuste de caudal y gota; vencida, no se autoriza aplicar.</documentation>
      <property key="Fuente" value="V7: término del glosario y su definición o su forma de registro en la entrevista"/>
    </element>
    <element xsi:type="archimate:AssociationRelationship" name="significa" id="r-lu2-005" source="bo-bateria" target="mn-bateria">
      <documentation>El término «Batería» significa: Pertenece a la base, rota entre drones y cuenta sus propios ciclos.</documentation>
      <property key="Fuente" value="V7: término del glosario y su definición o su forma de registro en la entrevista"/>
    </element>
    <element xsi:type="archimate:AssociationRelationship" name="significa" id="r-lu2-006" source="bo-uso" target="mn-uso">
      <documentation>El término «Registro de uso» significa: Horas, ciclos y baterías de cada vuelo que alimentan los acumulados.</documentation>
      <property key="Fuente" value="V7: término del glosario y su definición o su forma de registro en la entrevista"/>
    </element>
    <element xsi:type="archimate:AssociationRelationship" name="significa" id="r-lu2-007" source="bo-ot" target="mn-ot">
      <documentation>El término «Orden de trabajo» significa: Intervención sobre un dron; pasa de programada a cerrada y cerrada no se modifica.</documentation>
      <property key="Fuente" value="V7: término del glosario y su definición o su forma de registro en la entrevista"/>
    </element>
    <element xsi:type="archimate:AssociationRelationship" name="significa" id="r-lu2-008" source="bo-lu-check" target="mn-lu-check">
      <documentation>El término «Checklist» significa: Lista de tareas de la orden con resultado conforme, no conforme o no aplica.</documentation>
      <property key="Fuente" value="V7: término del glosario y su definición o su forma de registro en la entrevista"/>
    </element>
    <element xsi:type="archimate:AssociationRelationship" name="significa" id="r-lu2-009" source="bo-lu-exist" target="mn-lu-exist">
      <documentation>El término «Existencia» significa: Cantidad de un repuesto en la bodega de una base, según Siigo.</documentation>
      <property key="Fuente" value="V7: término del glosario y su definición o su forma de registro en la entrevista"/>
    </element>
    <element xsi:type="archimate:AssociationRelationship" name="significa" id="r-lu2-010" source="bo-lu-cert" target="mn-lu-cert">
      <documentation>El término «Certificación» significa: Acreditación de piloto o técnico con modelos habilitados y vencimiento.</documentation>
      <property key="Fuente" value="V7: término del glosario y su definición o su forma de registro en la entrevista"/>
    </element>
    <element xsi:type="archimate:AssociationRelationship" name="significa" id="r-lu2-011" source="bo-libro" target="mn-libro">
      <documentation>El término «Libro de mantenimiento» significa: Evidencia completa de un dron, exportable en PDF y conservada 5 años.</documentation>
      <property key="Fuente" value="V7: término del glosario y su definición o su forma de registro en la entrevista"/>
    </element>
    <element xsi:type="archimate:AssociationRelationship" name="significa" id="r-lu2-012" source="bo-notificacion" target="mn-notificacion">
      <documentation>El término «Notificación» significa: Aviso a una persona según su rol, por correo o celular; reemplaza WhatsApp.</documentation>
      <property key="Fuente" value="V7: término del glosario y su definición o su forma de registro en la entrevista"/>
    </element>
    <element xsi:type="archimate:AssociationRelationship" name="significa" id="r-lu2-013" source="bo-lu-cicdron" target="mn-lu-cicdron">
      <documentation>El término «Ciclo de dron» significa: Un despegue y un aterrizaje; cada salida de aspersión es un ciclo.</documentation>
      <property key="Fuente" value="V7: término del glosario y su definición o su forma de registro en la entrevista"/>
    </element>
    <element xsi:type="archimate:AssociationRelationship" name="significa" id="r-lu2-014" source="bo-lu-cicbat" target="mn-lu-cicbat">
      <documentation>El término «Ciclo de batería» significa: Una descarga en vuelo y su recarga; la cuenta la propia batería.</documentation>
      <property key="Fuente" value="V7: término del glosario y su definición o su forma de registro en la entrevista"/>
    </element>
    <element xsi:type="archimate:AssociationRelationship" name="significa" id="r-lu2-015" source="bo-lu-contador" target="mn-lu-contador">
      <documentation>El término «Contador de la tarea» significa: Uso desde la última ejecución de una tarea; se reinicia al cumplirla.</documentation>
      <property key="Fuente" value="V7: término del glosario y su definición o su forma de registro en la entrevista"/>
    </element>
    <element xsi:type="archimate:AssociationRelationship" name="significa" id="r-lu2-016" source="bo-lu-acum" target="mn-lu-acum">
      <documentation>El término «Acumulado de horas y ciclos» significa: Horas y ciclos que suma el dron o el componente; viajan con el componente.</documentation>
      <property key="Fuente" value="V7: término del glosario y su definición o su forma de registro en la entrevista"/>
    </element>
    <element xsi:type="archimate:AssociationRelationship" name="significa" id="r-lu2-017" source="bo-vencimiento" target="mn-vencimiento">
      <documentation>El término «Vencimiento de tarea» significa: Momento (fecha, horas o ciclos) en que una tarea deja de estar al día.</documentation>
      <property key="Fuente" value="V7: término del glosario y su definición o su forma de registro en la entrevista"/>
    </element>
    <element xsi:type="archimate:AssociationRelationship" name="significa" id="r-lu2-018" source="bo-lu-vcert" target="mn-lu-vcert">
      <documentation>El término «Vencimiento de certificación» significa: Fecha en que una certificación pierde vigencia; sin ella no se vuela ni se firma.</documentation>
      <property key="Fuente" value="V7: término del glosario y su definición o su forma de registro en la entrevista"/>
    </element>
    <element xsi:type="archimate:AssociationRelationship" name="significa" id="r-lu2-019" source="bo-disponibilidad" target="mn-disponibilidad">
      <documentation>El término «Disponibilidad de la flota» significa: Estado de cada dron por día que Mantenimiento entrega a Programación.</documentation>
      <property key="Fuente" value="V7: término del glosario y su definición o su forma de registro en la entrevista"/>
    </element>
    <element xsi:type="archimate:AssociationRelationship" name="significa" id="r-lu2-020" source="bo-lu-idisp" target="mn-lu-idisp">
      <documentation>El término «Indicador de disponibilidad» significa: Días-dron disponibles sobre días-dron del periodo; meta 90 % o más.</documentation>
      <property key="Fuente" value="V7: término del glosario y su definición o su forma de registro en la entrevista"/>
    </element>
    <element xsi:type="archimate:AssociationRelationship" name="significa" id="r-lu2-021" source="bo-lu-lib" target="mn-lu-lib">
      <documentation>El término «Liberación a servicio» significa: Declaración firmada de que el dron vuelve a operar tras un mantenimiento.</documentation>
      <property key="Fuente" value="V7: término del glosario y su definición o su forma de registro en la entrevista"/>
    </element>
    <element xsi:type="archimate:AssociationRelationship" name="significa" id="r-lu2-022" source="bo-lu-paquete" target="mn-lu-paquete">
      <documentation>El término «Paquete de servicio» significa: Grupo de tareas que se ejecutan juntas (servicio de 50 h, de 100 h, mayor).</documentation>
      <property key="Fuente" value="V7: término del glosario y su definición o su forma de registro en la entrevista"/>
    </element>
    <element xsi:type="archimate:AssociationRelationship" name="significa" id="r-lu2-023" source="bo-lu-inspesp" target="mn-lu-inspesp">
      <documentation>El término «Inspección especial» significa: Inspección completa tras caída o aterrizaje brusco, o al volver del taller.</documentation>
      <property key="Fuente" value="V7: término del glosario y su definición o su forma de registro en la entrevista"/>
    </element>
    <element xsi:type="archimate:AssociationRelationship" name="significa" id="r-lu2-024" source="bo-lu-trasdron" target="mn-lu-trasdron">
      <documentation>El término «Traslado de dron» significa: Cambio de base de un dron; cambia su ubicación actual.</documentation>
      <property key="Fuente" value="V7: término del glosario y su definición o su forma de registro en la entrevista"/>
    </element>
    <element xsi:type="archimate:AssociationRelationship" name="significa" id="r-lu2-025" source="bo-lu-trasrep" target="mn-lu-trasrep">
      <documentation>El término «Traslado de repuestos» significa: Envío de repuestos desde la bodega de otra base (1 a 2 días).</documentation>
      <property key="Fuente" value="V7: término del glosario y su definición o su forma de registro en la entrevista"/>
    </element>
    <element xsi:type="archimate:RealizationRelationship" name="representa" id="r-lu2-026" source="rp-estado" target="bo-estado">
      <documentation>«Tablero de estado de la flota» representa el término «Estado de aeronavegabilidad».</documentation>
      <property key="Fuente" value="V7: término del glosario y su definición o su forma de registro en la entrevista"/>
    </element>
    <element xsi:type="archimate:RealizationRelationship" name="representa" id="r-lu2-027" source="rp-lu-prev" target="bo-lu-prev">
      <documentation>«Formato FM-02 de inspección prevuelo (papel)» representa el término «Inspección prevuelo».</documentation>
      <property key="Fuente" value="V7: término del glosario y su definición o su forma de registro en la entrevista"/>
    </element>
    <element xsi:type="archimate:RealizationRelationship" name="representa" id="r-lu2-028" source="rp-lu-pmaestro" target="bo-lu-pmaestro">
      <documentation>«Excel maestro de la matriz de mantenimiento» representa el término «Plan maestro de tareas».</documentation>
      <property key="Fuente" value="V7: término del glosario y su definición o su forma de registro en la entrevista"/>
    </element>
    <element xsi:type="archimate:RealizationRelationship" name="representa" id="r-lu2-029" source="rp-lu-calib" target="bo-lu-calib">
      <documentation>«Formato FM-06 de registro de calibración» representa el término «Calibración de boquillas y caudal».</documentation>
      <property key="Fuente" value="V7: término del glosario y su definición o su forma de registro en la entrevista"/>
    </element>
    <element xsi:type="archimate:RealizationRelationship" name="representa" id="r-lu2-030" source="rp-bateria" target="bo-bateria">
      <documentation>«Excel de control de baterías por base» representa el término «Batería».</documentation>
      <property key="Fuente" value="V7: término del glosario y su definición o su forma de registro en la entrevista"/>
    </element>
    <element xsi:type="archimate:RealizationRelationship" name="representa" id="r-lu2-031" source="rp-uso" target="bo-uso">
      <documentation>«Formato FM-01 bitácora de vuelo (Excel o papel)» representa el término «Registro de uso».</documentation>
      <property key="Fuente" value="V7: término del glosario y su definición o su forma de registro en la entrevista"/>
    </element>
    <element xsi:type="archimate:RealizationRelationship" name="representa" id="r-lu2-032" source="rp-ot" target="bo-ot">
      <documentation>«Formato FM-03 de orden de trabajo (papel escaneado a Drive)» representa el término «Orden de trabajo».</documentation>
      <property key="Fuente" value="V7: término del glosario y su definición o su forma de registro en la entrevista"/>
    </element>
    <element xsi:type="archimate:RealizationRelationship" name="representa" id="r-lu2-033" source="rp-lu-check" target="bo-lu-check">
      <documentation>«Formato FM-05 checklist del servicio de 100 h» representa el término «Checklist».</documentation>
      <property key="Fuente" value="V7: término del glosario y su definición o su forma de registro en la entrevista"/>
    </element>
    <element xsi:type="archimate:RealizationRelationship" name="representa" id="r-lu2-034" source="rp-lu-exist" target="bo-lu-exist">
      <documentation>«Inventario de Siigo Nube (una bodega por base)» representa el término «Existencia».</documentation>
      <property key="Fuente" value="V7: término del glosario y su definición o su forma de registro en la entrevista"/>
    </element>
    <element xsi:type="archimate:RealizationRelationship" name="representa" id="r-lu2-035" source="rp-lu-cert" target="bo-lu-cert">
      <documentation>«Excel de talento humano y carpetas físicas» representa el término «Certificación».</documentation>
      <property key="Fuente" value="V7: término del glosario y su definición o su forma de registro en la entrevista"/>
    </element>
    <element xsi:type="archimate:RealizationRelationship" name="representa" id="r-lu2-036" source="rp-libro" target="bo-libro">
      <documentation>«Libro de mantenimiento en PDF» representa el término «Libro de mantenimiento».</documentation>
      <property key="Fuente" value="V7: término del glosario y su definición o su forma de registro en la entrevista"/>
    </element>
    <element xsi:type="archimate:RealizationRelationship" name="representa" id="r-lu2-037" source="rp-notificacion" target="bo-notificacion">
      <documentation>«Correo o notificación en el celular» representa el término «Notificación».</documentation>
      <property key="Fuente" value="V7: término del glosario y su definición o su forma de registro en la entrevista"/>
    </element>
  </folder>
