      <property key="Fuente" value="V4b: la función realiza «Gestionar configuración de dron» (dfs-configuracion)"/>
    </element>
    <element xsi:type="archimate:RealizationRelationship" name="materializa" id="r-tv-020" source="fn-configuracion" target="cap-m-baterias">
