    <element xsi:type="archimate:RealizationRelationship" name="implementa" id="r-tv-001" source="ac-uso" target="rq-uso">
      <documentation>Contexto Registro de uso implementa el requisito «Capturar el uso desde los fabricantes y acumularlo a dron, componentes y baterías».</documentation>
      <property key="Trazabilidad" value="Requisito → componente de aplicación"/>
      <property key="Fuente" value="§8 «¿En qué punto específico entraría la digitalización?» punto 1: «que las horas y ciclos lleguen de los registros de vuelo de los fabricantes y que el piloto solo confirme o complete»"/>
    </element>
    <element xsi:type="archimate:RealizationRelationship" name="implementa" id="r-tv-002" source="ac-configuracion" target="rq-uso">
      <documentation>Contexto Configuración de flota y vida de componentes implementa el requisito «Capturar el uso desde los fabricantes y acumularlo a dron, componentes y baterías».</documentation>
      <property key="Trazabilidad" value="Requisito → componente de aplicación"/>
      <property key="Fuente" value="§8 «¿En qué punto específico entraría la digitalización?» punto 1: «Que se acumulen al dron y a sus componentes instalados»; §10: «Los componentes y las baterías tienen vida propia»"/>
    </element>
    <element xsi:type="archimate:RealizationRelationship" name="implementa" id="r-tv-003" source="ac-planeacion" target="rq-bloqueo">
      <documentation>Contexto Planeación del mantenimiento implementa el requisito «Calcular vencimientos (lo que ocurra primero) y bloquear drones no aeronavegables».</documentation>
      <property key="Trazabilidad" value="Requisito → componente de aplicación"/>
      <property key="Fuente" value="§8 «¿En qué punto específico entraría la digitalización?» punto 3: «Cálculo continuo de vencimientos con las reglas de lo que ocurra primero»"/>
    </element>
    <element xsi:type="archimate:RealizationRelationship" name="implementa" id="r-tv-004" source="ac-aeronav" target="rq-bloqueo">
      <documentation>Contexto Aeronavegabilidad y estado de flota implementa el requisito «Calcular vencimientos (lo que ocurra primero) y bloquear drones no aeronavegables».</documentation>
      <property key="Trazabilidad" value="Requisito → componente de aplicación"/>
      <property key="Fuente" value="§8 «¿En qué punto específico entraría la digitalización?» punto 4: «Bloqueo automático de drones con tareas vencidas o fallas abiertas»"/>
    </element>
    <element xsi:type="archimate:RealizationRelationship" name="implementa" id="r-tv-005" source="ac-planeacion" target="rq-plan">
      <documentation>Contexto Planeación del mantenimiento implementa el requisito «Planear la semana y proyectar 30 días de mantenimientos y repuestos».</documentation>
      <property key="Trazabilidad" value="Requisito → componente de aplicación"/>
      <property key="Fuente" value="§8 «¿En qué punto específico entraría la digitalización?» punto 5: «generar la propuesta de plan semanal y la proyección a 30 días»"/>
    </element>
    <element xsi:type="archimate:RealizationRelationship" name="implementa" id="r-tv-006" source="ac-abastecimiento" target="rq-plan">
      <documentation>Contexto Abastecimiento de repuestos implementa el requisito «Planear la semana y proyectar 30 días de mantenimientos y repuestos».</documentation>
      <property key="Trazabilidad" value="Requisito → componente de aplicación"/>
      <property key="Fuente" value="§8 «¿En qué punto específico entraría la digitalización?» punto 5: «con repuestos requeridos»; §5: «qué repuestos van a hacer falta por base»"/>
    </element>
    <element xsi:type="archimate:RealizationRelationship" name="implementa" id="r-tv-007" source="ac-ot" target="rq-ot">
      <documentation>Contexto Órdenes de trabajo implementa el requisito «Órdenes de trabajo digitales con checklist, fotos y doble firma».</documentation>
      <property key="Trazabilidad" value="Requisito → componente de aplicación"/>
      <property key="Fuente" value="§8 «¿En qué punto específico entraría la digitalización?» punto 6: «Órdenes de trabajo digitales en la tablet, con checklist, fotos, firmas»"/>
    </element>
    <element xsi:type="archimate:RealizationRelationship" name="implementa" id="r-tv-008" source="ac-plataforma" target="rq-ot">
      <documentation>Contexto Identidad y notificaciones implementa el requisito «Órdenes de trabajo digitales con checklist, fotos y doble firma».</documentation>
      <property key="Trazabilidad" value="Requisito → componente de aplicación"/>
      <property key="Fuente" value="§8 «¿En qué punto específico entraría la digitalización?» punto 6: «firmas»; V8: servicio «Autenticar usuario y registrar firma» del contexto Identidad y notificaciones | Inferencia: la firma de la orden se apoya en la identidad del usuario que gestiona este contexto"/>
    </element>
    <element xsi:type="archimate:RealizationRelationship" name="implementa" id="r-tv-009" source="ac-uso" target="rq-integrar">
      <documentation>Contexto Registro de uso implementa el requisito «Intercambiar con fabricantes, Siigo y Programación sin depender de ellos».</documentation>
      <property key="Trazabilidad" value="Requisito → componente de aplicación"/>
      <property key="Fuente" value="§10 punto 5: «Que no dependa de un fabricante ni de Siigo»; V8: «Adaptadores de fabricante (ACL)»"/>
    </element>
    <element xsi:type="archimate:RealizationRelationship" name="implementa" id="r-tv-010" source="ac-abastecimiento" target="rq-integrar">
      <documentation>Contexto Abastecimiento de repuestos implementa el requisito «Intercambiar con fabricantes, Siigo y Programación sin depender de ellos».</documentation>
      <property key="Trazabilidad" value="Requisito → componente de aplicación"/>
      <property key="Fuente" value="§8 «¿En qué punto específico entraría la digitalización?» punto 7: «Integración con inventario y compras»; V8: «Adaptador Siigo (ACL)»"/>
    </element>
    <element xsi:type="archimate:RealizationRelationship" name="implementa" id="r-tv-011" source="ac-planeacion" target="rq-integrar">
      <documentation>Contexto Planeación del mantenimiento implementa el requisito «Intercambiar con fabricantes, Siigo y Programación sin depender de ellos».</documentation>
      <property key="Trazabilidad" value="Requisito → componente de aplicación"/>
      <property key="Fuente" value="V8: «Adaptador de asignaciones de Programación (ACL)»; contrato ct-acs-programacion"/>
    </element>
    <element xsi:type="archimate:RealizationRelationship" name="implementa" id="r-tv-012" source="ac-aeronav" target="rq-integrar">
      <documentation>Contexto Aeronavegabilidad y estado de flota implementa el requisito «Intercambiar con fabricantes, Siigo y Programación sin depender de ellos».</documentation>
      <property key="Trazabilidad" value="Requisito → componente de aplicación"/>
      <property key="Fuente" value="§8 «¿En qué punto específico entraría la digitalización?» punto 4: «que esa disponibilidad la vea operaciones»; V8: «API Disponibilidad de flota (OHS)»"/>
    </element>
    <element xsi:type="archimate:RealizationRelationship" name="implementa" id="r-tv-013" source="ac-indicadores" target="rq-evidencia">
      <documentation>Contexto Indicadores y reportes implementa el requisito «Calcular indicadores y exportar el libro de mantenimiento».</documentation>
      <property key="Trazabilidad" value="Requisito → componente de aplicación"/>
      <property key="Fuente" value="§8 «¿En qué punto específico entraría la digitalización?» punto 8: «Indicadores y libro de mantenimiento exportable»"/>
    </element>
    <element xsi:type="archimate:RealizationRelationship" name="cumple" id="r-tv-014" source="ac-aeronav" target="c-offline">
      <documentation>Contexto Aeronavegabilidad y estado de flota cumple la restricción «Prevuelo, novedades y OT funcionan sin conexión y en menos de 2 minutos».</documentation>
      <property key="Trazabilidad" value="Restricción → componente de aplicación"/>
      <property key="Fuente" value="§7: «al menos el prevuelo, el reporte de novedades del piloto … funcionen sin conexión»"/>
    </element>
    <element xsi:type="archimate:RealizationRelationship" name="cumple" id="r-tv-015" source="ac-ot" target="c-offline">
      <documentation>Contexto Órdenes de trabajo cumple la restricción «Prevuelo, novedades y OT funcionan sin conexión y en menos de 2 minutos».</documentation>
      <property key="Trazabilidad" value="Restricción → componente de aplicación"/>
      <property key="Fuente" value="§7: «… y el registro de tareas del técnico funcionen sin conexión»"/>
    </element>
    <element xsi:type="archimate:RealizationRelationship" name="cumple" id="r-tv-016" source="ac-abastecimiento" target="c-siigo">
      <documentation>Contexto Abastecimiento de repuestos cumple la restricción «No reemplazar Siigo: es dueño de existencias y costo».</documentation>
      <property key="Trazabilidad" value="Restricción → componente de aplicación"/>
      <property key="Fuente" value="Restricción «No reemplazar Siigo»; documentación del contexto: «Siigo es el dueño de existencias»"/>
    </element>
    <element xsi:type="archimate:RealizationRelationship" name="cumple" id="r-tv-017" source="ac-plataforma" target="c-nube">
      <documentation>Contexto Identidad y notificaciones cumple la restricción «Nube de costo moderado, login con Google y usuarios con roles».</documentation>
      <property key="Trazabilidad" value="Restricción → componente de aplicación"/>
      <property key="Fuente" value="§7: «ojalá inicio de sesión con nuestras cuentas de Google»; documentación del contexto: «inicio de sesión con Google, roles»"/>
    </element>
    <element xsi:type="archimate:RealizationRelationship" name="materializa" id="r-tv-018" source="fn-uso" target="cap-m-uso">
      <documentation>Función registro de uso materializa la capacidad «Registro de uso de la flota».</documentation>
      <property key="Trazabilidad" value="Capacidad → función de negocio"/>
      <property key="Fuente" value="V4b: la función realiza «Registro de uso de la flota» (ds-uso); V2: subcapacidad homónima"/>
    </element>
