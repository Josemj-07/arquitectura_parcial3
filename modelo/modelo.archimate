    </element>
    <element xsi:type="archimate:ApplicationInterface" name="API Disponibilidad de flota (OHS)" id="aif-aer-ohs">
      <documentation>Interfaz abierta REST/JSON que publica, por dron y día, estado, motivo, restricciones y ventanas de mantenimiento; avisa de inmediato cuando un dron queda en tierra.</documentation>
      <property key="Contexto" value="Aeronavegabilidad y estado de flota"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Patrón" value="Servicio de host abierto + lenguaje publicado (OHS/PL)"/>
      <property key="Fuente" value="§9: «les pedimos una interfaz pensada para que otro sistema la consuma»; contrato ct-acs-programacion: «Ninguna para consultar (interfaz abierta)»"/>
    </element>
    <element xsi:type="archimate:ApplicationInterface" name="Eventos de Aeronavegabilidad (PL)" id="aif-aer-ev">
      <documentation>Canal por el que el contexto publica sus eventos de dominio (DronPuestoEnTierra, NovedadReportada, DronLiberado…) en el lenguaje publicado del SGMF.</documentation>
      <property key="Contexto" value="Aeronavegabilidad y estado de flota"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Patrón" value="Lenguaje publicado (eventos de dominio)"/>
      <property key="Fuente" value="Contrato ct-dfs-vencimientos: «Protocolo: Interno (eventos de dominio)»; V6.1 eventos de aplicación | Inferencia: Canal de eventos por contexto: propuesta del arquitecto."/>
    </element>
    <element xsi:type="archimate:ApplicationInterface" name="Eventos de Planeación (PL)" id="aif-pla-ev">
      <documentation>Canal de eventos de dominio de Planeación: TareaVencida, PlanSemanalAprobado, ProyecciónGenerada.</documentation>
      <property key="Contexto" value="Planeación del mantenimiento"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Patrón" value="Lenguaje publicado (eventos de dominio)"/>
      <property key="Fuente" value="Contrato ct-dfs-vencimientos: «Protocolo: Interno (eventos de dominio)»; V6.2 | Inferencia: Canal de eventos por contexto: propuesta del arquitecto."/>
    </element>
    <element xsi:type="archimate:ApplicationInterface" name="Adaptador de asignaciones de Programación (ACL)" id="aif-pla-acl">
      <documentation>Lee la hoja de Google Sheets (o el archivo cargado) con las asignaciones de drones por día y las traduce al modelo de Planeación.</documentation>
      <property key="Contexto" value="Planeación del mantenimiento"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Patrón" value="Capa anticorrupción (ACL)"/>
      <property key="Fuente" value="§9: «En el corto plazo nos sirve que lea la hoja de Google o que se carguen las asignaciones»"/>
    </element>
    <element xsi:type="archimate:ApplicationInterface" name="Eventos de Configuración (PL)" id="aif-cfg-ev">
      <documentation>Canal de eventos de dominio de Configuración: ContadoresActualizados, ComponenteInstalado, CiclosDeBateríaActualizados, DronTrasladado, BateríaRetirada.</documentation>
      <property key="Contexto" value="Configuración de flota y vida de componentes"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Patrón" value="Lenguaje publicado (eventos de dominio)"/>
      <property key="Fuente" value="V6.3 eventos de aplicación y políticas hacia Recalcular vencimientos | Inferencia: Canal de eventos por contexto: propuesta del arquitecto."/>
    </element>
    <element xsi:type="archimate:ApplicationInterface" name="Eventos de Registro de uso (PL)" id="aif-uso-ev">
      <documentation>Canal de eventos de dominio de Registro de uso: UsoRegistrado, UsoConfirmado, UsoCorregido, InconsistenciaDetectada.</documentation>
      <property key="Contexto" value="Registro de uso"/>
      <property key="Clasificación" value="Soporte"/>
      <property key="Patrón" value="Lenguaje publicado (eventos de dominio)"/>
      <property key="Fuente" value="V6.4 eventos de aplicación y políticas hacia Acumular uso | Inferencia: Canal de eventos por contexto: propuesta del arquitecto."/>
    </element>
    <element xsi:type="archimate:ApplicationInterface" name="Adaptadores de fabricante (ACL)" id="aif-uso-acl">
      <documentation>Un adaptador por fabricante que lee el archivo CSV/Excel exportado (DJI, XAG) y lo traduce al registro de vuelo canónico; agregar un fabricante es agregar un adaptador.</documentation>
      <property key="Contexto" value="Registro de uso"/>
      <property key="Clasificación" value="Soporte"/>
      <property key="Patrón" value="Capa anticorrupción (ACL)"/>
      <property key="Fuente" value="§7: «El sistema no debe estar amarrado al formato de un fabricante»; §9: «que mañana se pueda agregar un tercer fabricante sin rehacer el sistema»"/>
    </element>
    <element xsi:type="archimate:ApplicationInterface" name="Eventos de Órdenes de trabajo (PL)" id="aif-ot-ev">
      <documentation>Canal de eventos de dominio de Órdenes de trabajo: OTProgramada, OTCerrada, ComponenteCambiadoEnOT, DronEnviadoATaller, OTPendienteDeInspección.</documentation>
      <property key="Contexto" value="Órdenes de trabajo"/>
      <property key="Clasificación" value="Soporte"/>
      <property key="Patrón" value="Lenguaje publicado (eventos de dominio)"/>
      <property key="Fuente" value="V6.5 eventos de aplicación y políticas | Inferencia: Canal de eventos por contexto: propuesta del arquitecto."/>
    </element>
    <element xsi:type="archimate:ApplicationInterface" name="Eventos de Abastecimiento (PL)" id="aif-aba-ev">
      <documentation>Canal de eventos de dominio de Abastecimiento: FaltanteDetectado, FaltanteProyectado.</documentation>
      <property key="Contexto" value="Abastecimiento de repuestos"/>
      <property key="Clasificación" value="Soporte"/>
      <property key="Patrón" value="Lenguaje publicado (eventos de dominio)"/>
      <property key="Fuente" value="V6.6 eventos de aplicación y políticas | Inferencia: Canal de eventos por contexto: propuesta del arquitecto."/>
    </element>
    <element xsi:type="archimate:ApplicationInterface" name="Adaptador Siigo (ACL)" id="aif-aba-acl">
      <documentation>Cliente de la API REST de Siigo Nube: trae catálogo, existencias y costo promedio; envía salidas y solicitudes, con cola si Siigo no responde.</documentation>
      <property key="Contexto" value="Abastecimiento de repuestos"/>
      <property key="Clasificación" value="Soporte"/>
      <property key="Patrón" value="Capa anticorrupción (ACL)"/>
      <property key="Fuente" value="§9: «Siigo es el dueño de las existencias y del costo… Si Siigo no está disponible, el sistema de mantenimiento no debe detenerse»"/>
    </element>
    <element xsi:type="archimate:ApplicationInterface" name="API Habilitaciones (OHS)" id="aif-per-ohs">
      <documentation>Consulta de vigencia de certificaciones y modelos habilitados por persona, que usan los contextos que validan quién vuela o firma.</documentation>
      <property key="Contexto" value="Personal habilitado"/>
      <property key="Clasificación" value="Genérico"/>
      <property key="Patrón" value="Servicio de host abierto + lenguaje publicado (OHS/PL)"/>
      <property key="Fuente" value="Modelo ac-personal: «el SGMF solo consulta vigencia y modelos habilitados»; §3 reglas 23-24"/>
    </element>
    <element xsi:type="archimate:ApplicationInterface" name="Eventos de Personal habilitado (PL)" id="aif-per-ev">
      <documentation>Canal de eventos de dominio de Personal habilitado: CertificaciónRegistrada, CertificaciónPorVencer.</documentation>
      <property key="Contexto" value="Personal habilitado"/>
      <property key="Clasificación" value="Genérico"/>
      <property key="Patrón" value="Lenguaje publicado (eventos de dominio)"/>
      <property key="Fuente" value="V6.7 eventos de aplicación | Inferencia: Canal de eventos por contexto: propuesta del arquitecto."/>
    </element>
    <element xsi:type="archimate:ApplicationInterface" name="Importador de certificaciones (ACL)" id="aif-per-acl">
      <documentation>Carga del Excel de Talento humano (o registro en pantalla) que traduce persona, certificación, modelos y vencimiento al modelo del SGMF.</documentation>
      <property key="Contexto" value="Personal habilitado"/>
      <property key="Clasificación" value="Genérico"/>
      <property key="Patrón" value="Capa anticorrupción (ACL)"/>
      <property key="Fuente" value="§9: «A corto plazo podría ser una carga de archivo o una pantalla… no queremos duplicar»"/>
    </element>
    <element xsi:type="archimate:ApplicationInterface" name="API Identidad y firma (OHS)" id="aif-idn-ohs">
      <documentation>Inicio de sesión con cuenta de Google, roles y firma digital sencilla (usuario autenticado + confirmación) para los demás contextos.</documentation>
      <property key="Contexto" value="Identidad y notificaciones"/>
      <property key="Clasificación" value="Genérico"/>
      <property key="Patrón" value="Servicio de host abierto + lenguaje publicado (OHS/PL)"/>
      <property key="Fuente" value="§7: «usuarios individuales con roles… inicio de sesión con nuestras cuentas de Google»; §3: «firmas digitales sencillas»"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Consultar disponibilidad de flota" id="svc-aer-disp">
      <documentation>Entrega, por dron y día (14 días), estado, motivo, restricciones y ventanas de mantenimiento, y avisa cuando un dron queda en tierra.</documentation>
      <property key="Contexto" value="Aeronavegabilidad y estado de flota"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Patrón" value="Servicio de host abierto + lenguaje publicado (OHS/PL)"/>
      <property key="Fuente" value="§9: «ofrezca la disponibilidad de la flota de una forma estándar que cualquier herramienta de programación pueda consultar»"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Publicar eventos de aeronavegabilidad" id="svc-aer-ev">
      <documentation>Pone a disposición de otros contextos los cambios de estado, novedades, diferimientos y liberaciones.</documentation>
      <property key="Contexto" value="Aeronavegabilidad y estado de flota"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Patrón" value="Lenguaje publicado (eventos de dominio)"/>
      <property key="Fuente" value="V6.1 políticas hacia Órdenes de trabajo y Notificación"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Publicar eventos de planeación" id="svc-pla-ev">
      <documentation>Pone a disposición tareas vencidas, plan semanal aprobado y proyección generada.</documentation>
      <property key="Contexto" value="Planeación del mantenimiento"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Patrón" value="Lenguaje publicado (eventos de dominio)"/>
      <property key="Fuente" value="V6.2 políticas hacia Aeronavegabilidad, Órdenes de trabajo y Abastecimiento"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Traducir asignaciones de Programación (ACL)" id="svc-pla-acl">
      <documentation>Convierte las asignaciones dron-servicio-día y horas estimadas en entrada para la proyección del plan.</documentation>
      <property key="Contexto" value="Planeación del mantenimiento"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Patrón" value="Capa anticorrupción (ACL)"/>
      <property key="Fuente" value="Contrato ct-acs-programacion: «Entrada: Asignaciones por día: dron, servicio, base y horas de vuelo estimadas»"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Publicar eventos de configuración" id="svc-cfg-ev">
      <documentation>Pone a disposición contadores acumulados, instalaciones, traslados y retiros de baterías.</documentation>
      <property key="Contexto" value="Configuración de flota y vida de componentes"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Patrón" value="Lenguaje publicado (eventos de dominio)"/>
      <property key="Fuente" value="V6.3 políticas hacia Recalcular vencimientos y Notificación"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Publicar eventos de uso" id="svc-uso-ev">
      <documentation>Pone a disposición el uso registrado, confirmado o corregido de cada vuelo y las inconsistencias.</documentation>
      <property key="Contexto" value="Registro de uso"/>
      <property key="Clasificación" value="Soporte"/>
      <property key="Patrón" value="Lenguaje publicado (eventos de dominio)"/>
      <property key="Fuente" value="V6.4 políticas hacia Acumular uso"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Traducir registros de vuelo de fabricantes (ACL)" id="svc-uso-acl">
      <documentation>Normaliza las exportaciones de cada fabricante, omite duplicados y señala inconsistencias.</documentation>
      <property key="Contexto" value="Registro de uso"/>
      <property key="Clasificación" value="Soporte"/>
      <property key="Patrón" value="Capa anticorrupción (ACL)"/>
      <property key="Fuente" value="Contrato ct-acs-fabricantes-vuelos: «Agregar un fabricante solo requiere agregar un adaptador»"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Publicar eventos de órdenes de trabajo" id="svc-ot-ev">
      <documentation>Pone a disposición órdenes programadas y cerradas, cambios de componentes y envíos a taller.</documentation>
      <property key="Contexto" value="Órdenes de trabajo"/>
      <property key="Clasificación" value="Soporte"/>
      <property key="Patrón" value="Lenguaje publicado (eventos de dominio)"/>
      <property key="Fuente" value="V6.5 políticas hacia Aeronavegabilidad, Planeación, Configuración y Abastecimiento"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Publicar eventos de abastecimiento" id="svc-aba-ev">
      <documentation>Pone a disposición faltantes detectados y proyectados.</documentation>
      <property key="Contexto" value="Abastecimiento de repuestos"/>
      <property key="Clasificación" value="Soporte"/>
      <property key="Patrón" value="Lenguaje publicado (eventos de dominio)"/>
      <property key="Fuente" value="V6.6 políticas hacia Órdenes de trabajo y Notificación"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Intercambiar inventario con Siigo (ACL)" id="svc-aba-acl">
      <documentation>Consulta existencias y costo en Siigo y le envía salidas y solicitudes de compra o traslado, encolando si no responde.</documentation>
      <property key="Contexto" value="Abastecimiento de repuestos"/>
      <property key="Clasificación" value="Soporte"/>
      <property key="Patrón" value="Capa anticorrupción (ACL)"/>
      <property key="Fuente" value="Contrato ct-acs-siigo: «el SGMF nunca se detiene por Siigo»"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Consultar habilitación vigente" id="svc-per-ohs">
      <documentation>Responde si una persona tiene certificación vigente para un modelo antes de volar, ejecutar, firmar o liberar.</documentation>
      <property key="Contexto" value="Personal habilitado"/>
      <property key="Clasificación" value="Genérico"/>
      <property key="Patrón" value="Servicio de host abierto + lenguaje publicado (OHS/PL)"/>
      <property key="Fuente" value="§3 reglas 23-24; V4b: Liberar, Prevuelo y Firmar leen Habilitación de personal"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Publicar eventos de personal" id="svc-per-ev">
      <documentation>Pone a disposición certificaciones registradas y por vencer.</documentation>
      <property key="Contexto" value="Personal habilitado"/>
      <property key="Clasificación" value="Genérico"/>
      <property key="Patrón" value="Lenguaje publicado (eventos de dominio)"/>
      <property key="Fuente" value="V6.7: CertificaciónPorVencer → Enviar notificación"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Importar certificaciones (ACL)" id="svc-per-acl">
      <documentation>Traduce el Excel de Talento humano a habilitaciones sin duplicar la lista.</documentation>
      <property key="Contexto" value="Personal habilitado"/>
      <property key="Clasificación" value="Genérico"/>
      <property key="Patrón" value="Capa anticorrupción (ACL)"/>
      <property key="Fuente" value="Contrato ct-acs-personal: «Bajo demanda; sin duplicar la lista de Talento humano»"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Autenticar usuario y registrar firma" id="svc-idn-ohs">
      <documentation>Autentica con cuenta de Google, aplica el rol y registra quién firmó, cuándo y desde qué base.</documentation>
      <property key="Contexto" value="Identidad y notificaciones"/>
      <property key="Clasificación" value="Genérico"/>
      <property key="Patrón" value="Servicio de host abierto + lenguaje publicado (OHS/PL)"/>
      <property key="Fuente" value="Modelo is-identidad sirve a Gestionar diferimiento y a Firmar y cerrar orden de trabajo; §3 firmas digitales sencillas"/>
    </element>
    <element xsi:type="archimate:ApplicationInterface" name="Consulta de calibración para Agronomía" id="aif-aer-agro">
      <documentation>Pantalla web y móvil (REST/JSON) en la que el agrónomo consulta, por dron, la fecha y el resultado de la última calibración de boquillas y caudal.</documentation>
      <property key="Contexto" value="Aeronavegabilidad y estado de flota"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Patrón" value="Servicio de host abierto + lenguaje publicado (OHS/PL)"/>
      <property key="Fuente" value="Contrato ct-acs-agronomia: «Consulta en pantalla web/móvil (REST/JSON)»; §9 (47): el agrónomo consulta antes de autorizar"/>
      <property key="Protocolo" value="Consulta en pantalla web/móvil (REST/JSON)"/>
      <property key="Dirección" value="Saliente"/>
      <property key="Contraparte" value="Proceso de calidad agronómica"/>
    </element>
    <element xsi:type="archimate:ApplicationInterface" name="Registro de avisos del fabricante (ACL)" id="aif-pla-aviso">
      <documentation>Formulario donde el jefe de mantenimiento registra el aviso técnico recibido por correo o PDF y el alcance (modelo o rango de series) que lo traduce a tareas.</documentation>
      <property key="Contexto" value="Planeación del mantenimiento"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Patrón" value="Capa anticorrupción (ACL)"/>
      <property key="Fuente" value="§9: «que yo pueda cargar el aviso y el sistema genere las tareas sobre los drones o componentes afectados»; contrato ct-acs-fabricantes-soporte: «Correo/PDF registrado en el SGMF»"/>
      <property key="Protocolo" value="Correo/PDF registrado en el SGMF"/>
      <property key="Dirección" value="Entrante"/>
      <property key="Contraparte" value="Distribuidores DJI y XAG"/>
    </element>
    <element xsi:type="archimate:ApplicationInterface" name="Registro de taller externo y garantías (ACL)" id="aif-ot-taller">
      <documentation>Registro de la salida de un equipo al distribuidor con su reporte de falla y de su regreso con el informe de reparación adjunto.</documentation>
      <property key="Contexto" value="Órdenes de trabajo"/>
      <property key="Clasificación" value="Soporte"/>
      <property key="Patrón" value="Capa anticorrupción (ACL)"/>
      <property key="Fuente" value="§9: «Seguimiento de envíos a taller externo… Necesario (no como integración, sino como registro)»"/>
      <property key="Protocolo" value="Correo/PDF registrado; envío físico por transportadora"/>
      <property key="Dirección" value="Bidireccional"/>
      <property key="Contraparte" value="Distribuidores DJI y XAG (taller externo)"/>
    </element>
    <element xsi:type="archimate:ApplicationInterface" name="Relación de baterías dadas de baja" id="aif-cfg-res">
      <documentation>Documento que lista las baterías y filtros entregados al gestor y registro del certificado de disposición que devuelve; aviso a SST cuando una batería se retira por daño.</documentation>
      <property key="Contexto" value="Configuración de flota y vida de componentes"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Patrón" value="Conformista"/>
      <property key="Fuente" value="Contrato ct-acs-residuos: «Documento físico o correo registrado en el SGMF»"/>
      <property key="Protocolo" value="Documento físico o correo registrado en el SGMF"/>
      <property key="Dirección" value="Bidireccional"/>
      <property key="Contraparte" value="Gestor de residuos peligrosos y SST"/>
    </element>
    <element xsi:type="archimate:ApplicationInterface" name="Exportador de evidencia en PDF" id="aif-ind-pdf">
      <documentation>Genera los documentos de salida en PDF (libro de mantenimiento, constancias, resumen de flota, reportes de incidente) listos para enviar por correo.</documentation>
      <property key="Contexto" value="Indicadores y reportes"/>
      <property key="Clasificación" value="Genérico"/>
      <property key="Patrón" value="Conformista"/>
      <property key="Fuente" value="§9: «Lo que sí necesitamos es que el sistema produzca los documentos de salida listos para enviar»"/>
      <property key="Protocolo" value="PDF por correo o trámite en línea (sin API)"/>
      <property key="Dirección" value="Saliente (por documento)"/>
      <property key="Contraparte" value="Aerocivil, ICA, aseguradora y clientes"/>
    </element>
    <element xsi:type="archimate:ApplicationInterface" name="Exportación de costos (CSV/Excel)" id="aif-ind-csv">
      <documentation>Archivo mensual con el costo de mantenimiento por dron, base y mes y las horas de vuelo; recibe la tarifa anual de hora-hombre.</documentation>
      <property key="Contexto" value="Indicadores y reportes"/>
      <property key="Clasificación" value="Genérico"/>
      <property key="Patrón" value="Cliente–Proveedor"/>
      <property key="Fuente" value="Contrato ct-acs-finanzas: «Exportación CSV/Excel mensual»"/>
      <property key="Protocolo" value="Exportación CSV/Excel mensual"/>
      <property key="Dirección" value="Bidireccional"/>
      <property key="Contraparte" value="Administración y finanzas"/>
    </element>
    <element xsi:type="archimate:ApplicationInterface" name="Conector Google Workspace" id="aif-idn-google">
      <documentation>Integración con el inicio de sesión de Google (cuentas de la empresa) y con Gmail para enviar las notificaciones por correo.</documentation>
      <property key="Contexto" value="Identidad y notificaciones"/>
      <property key="Clasificación" value="Genérico"/>
      <property key="Patrón" value="Conformista"/>
      <property key="Fuente" value="§7: «ojalá inicio de sesión con nuestras cuentas de Google»; §9 [V]: avisos por correo"/>
      <property key="Protocolo" value="Inicio de sesión con Google y correo de Google Workspace"/>
      <property key="Dirección" value="Bidireccional"/>
      <property key="Contraparte" value="Google Workspace"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Consultar calibración vigente" id="svc-aer-calib">
      <documentation>Responde, por dron, fecha y resultado de la última calibración de boquillas y caudal y si está vigente; sin calibración vigente el dron no es apto para aplicar.</documentation>
      <property key="Contexto" value="Aeronavegabilidad y estado de flota"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Patrón" value="Servicio de host abierto + lenguaje publicado (OHS/PL)"/>
      <property key="Fuente" value="Contrato ct-acs-agronomia: «Dron sin calibración vigente: no apto para aplicar»"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Registrar avisos técnicos del fabricante (ACL)" id="svc-pla-aviso">
      <documentation>Traduce el aviso del fabricante (modelo o rango de series, fecha límite) en tareas únicas obligatorias sobre los equipos afectados.</documentation>
      <property key="Contexto" value="Planeación del mantenimiento"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Patrón" value="Capa anticorrupción (ACL)"/>
      <property key="Fuente" value="Contrato ct-acs-fabricantes-soporte: «El aviso genera tareas únicas obligatorias con fecha límite»"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Gestionar envío a taller y garantía (ACL)" id="svc-ot-taller">
      <documentation>Registra el envío con reporte de falla, la solicitud de garantía y el regreso con informe; sin informe, el dron no se libera.</documentation>
      <property key="Contexto" value="Órdenes de trabajo"/>
      <property key="Clasificación" value="Soporte"/>
      <property key="Patrón" value="Capa anticorrupción (ACL)"/>
      <property key="Fuente" value="Contrato ct-acs-fabricantes-soporte: «Regreso sin informe: el dron no se libera»"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Reportar baterías dadas de baja" id="svc-cfg-res">
      <documentation>Prepara la relación de baterías y filtros para el gestor, registra el certificado de disposición y avisa a SST de los retiros por daño.</documentation>
      <property key="Contexto" value="Configuración de flota y vida de componentes"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Patrón" value="Conformista"/>
      <property key="Fuente" value="Contrato ct-acs-residuos: «Batería no retirada: no se incluye en la relación»"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Generar evidencia para autoridades" id="svc-ind-aut">
      <documentation>Produce el libro de mantenimiento por dron, los reportes de incidente, los registros de calibración y las altas y bajas; solo con registros firmados.</documentation>
      <property key="Contexto" value="Indicadores y reportes"/>
      <property key="Clasificación" value="Genérico"/>
      <property key="Patrón" value="Conformista"/>
      <property key="Fuente" value="Contrato ct-acs-autoridades: «Disponible en minutos (hoy toma 2 días)»"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Generar constancias y resumen de flota" id="svc-ind-aseg">
      <documentation>Produce el resumen anual de la flota, el historial completo de un dron y la constancia de mantenimiento y calibración vigente por dron o grupo.</documentation>
      <property key="Contexto" value="Indicadores y reportes"/>
      <property key="Clasificación" value="Genérico"/>
      <property key="Patrón" value="Conformista"/>
      <property key="Fuente" value="Contrato ct-acs-aseguradora-clientes: «Dron con tareas vencidas o calibración vencida: la constancia no se emite»"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Exportar costos de mantenimiento" id="svc-ind-costos">
      <documentation>Entrega a Finanzas el costo de mantenimiento por dron, base y mes al cierre contable y toma la tarifa de hora-hombre vigente.</documentation>
      <property key="Contexto" value="Indicadores y reportes"/>
      <property key="Clasificación" value="Genérico"/>
      <property key="Patrón" value="Cliente–Proveedor"/>
      <property key="Fuente" value="Contrato ct-acs-finanzas: «Mensual, al cierre contable»"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Autenticar con Google y enviar correo" id="svc-idn-google">
      <documentation>Valida la cuenta de Google del usuario y envía las notificaciones por correo de la empresa.</documentation>
      <property key="Contexto" value="Identidad y notificaciones"/>
      <property key="Clasificación" value="Genérico"/>
      <property key="Patrón" value="Conformista"/>
      <property key="Fuente" value="§7: inicio de sesión con cuentas de Google; servicio is-notificaciones: «Avisos por correo o push»"/>
    </element>
  </folder>
  <folder name="Technology &amp; Physical" id="id-352442bdbcf64685a12ac2e71edb61fc" type="technology"/>
  <folder name="Motivation" id="id-02341160a35b4bb58316712fdcf58426" type="motivation">
    <element xsi:type="archimate:Stakeholder" name="Gerencia general" id="sh-gerencia">
      <documentation>Decide inversión, bajas de drones y presupuesto; revisa indicadores.</documentation>
    </element>
    <element xsi:type="archimate:Stakeholder" name="Jefe de mantenimiento" id="sh-jefemant">
      <documentation>Dueño del proceso: plan, intervalos, diferimientos y liberación.</documentation>
    </element>
    <element xsi:type="archimate:Stakeholder" name="Operaciones (coordinadores y pilotos)" id="sh-operaciones">
      <documentation>Programan, vuelan y reportan horas, ciclos y fallas.</documentation>
    </element>
    <element xsi:type="archimate:Stakeholder" name="Técnicos e inspectores" id="sh-tecnicos">
      <documentation>Ejecutan y verifican el mantenimiento; doble firma.</documentation>
    </element>
    <element xsi:type="archimate:Stakeholder" name="Clientes bananeros certificados" id="sh-clientes">
      <documentation>Exigen evidencia de mantenimiento y calibración (GlobalG.A.P.).</documentation>
    </element>
    <element xsi:type="archimate:Stakeholder" name="Autoridades (Aerocivil e ICA)" id="sh-autoridades">
      <documentation>RAC 100 y regulación de aplicación de plaguicidas; inspeccionan registros.</documentation>
    </element>
    <element xsi:type="archimate:Stakeholder" name="Aseguradora de la flota" id="sh-aseguradora">
      <documentation>Pide estado de flota e historial en siniestros.</documentation>
    </element>
    <element xsi:type="archimate:Driver" name="Cumplimiento de los ciclos de aplicación" id="dr-cumplimiento">
      <documentation>Un retraso de 2-3 días en sigatoka es pérdida de fruta; cada día-dron perdido cuesta 2-3 M COP.</documentation>
    </element>
    <element xsi:type="archimate:Driver" name="Seguridad operacional de la flota" id="dr-seguridad">
      <documentation>Dos caídas en 2025.</documentation>
    </element>
    <element xsi:type="archimate:Driver" name="Normatividad y certificaciones (RAC 100, ICA, ISO 9001 2027)" id="dr-normatividad">
      <documentation>Mantener según el fabricante con registros que lo demuestren.</documentation>
    </element>
    <element xsi:type="archimate:Driver" name="Costo de mantenimiento" id="dr-costo">
      <documentation>Estimado entre 70.000 y 95.000 COP por hora sin datos confiables.</documentation>
    </element>
    <element xsi:type="archimate:Assessment" name="Horas y ciclos a mano que no cuadran con la plataforma del fabricante" id="as-horas"/>
    <element xsi:type="archimate:Assessment" name="Componentes y baterías pierden su historia al rotar" id="as-historia">
      <documentation>caída de 2025 por batería fuera de límite.</documentation>
    </element>
    <element xsi:type="archimate:Assessment" name="Drones varados por repuestos no anticipados (disponibilidad cercana al 82 %)" id="as-repuestos">
      <documentation>Julio 2026: 3 drones parados 4-6 días.</documentation>
    </element>
    <element xsi:type="archimate:Assessment" name="Diferimientos y liberaciones sin rastro (WhatsApp, papel)" id="as-rastro">
      <documentation>2 días para reunir registros ante la Aerocivil.</documentation>
    </element>
    <element xsi:type="archimate:Assessment" name="Indicadores inexistentes o no confiables" id="as-indicadores"/>
    <element xsi:type="archimate:Goal" name="Mantener la flota disponible" id="g-disponible">
      <documentation>Meta derivada de la misión de la empresa y de los problemas actuales del mantenimiento.</documentation>
    </element>
    <element xsi:type="archimate:Goal" name="Operar la flota de forma segura" id="g-segura">
      <documentation>Meta derivada de la misión de la empresa y de los problemas actuales del mantenimiento.</documentation>
    </element>
    <element xsi:type="archimate:Goal" name="Cumplir la normatividad y demostrarlo con evidencia" id="g-normatividad">
      <documentation>Meta derivada de la misión de la empresa y de los problemas actuales del mantenimiento.</documentation>
    </element>
    <element xsi:type="archimate:Goal" name="Controlar el costo de mantenimiento" id="g-costo">
      <documentation>Meta derivada de la misión de la empresa y de los problemas actuales del mantenimiento.</documentation>
    </element>
    <element xsi:type="archimate:Outcome" name="Disponibilidad de la flota de al menos 90 %" id="o-disp90"/>
    <element xsi:type="archimate:Outcome" name="Cumplimiento del plan preventivo de al menos 95 %" id="o-plan95"/>
    <element xsi:type="archimate:Outcome" name="Cero vuelos con mantenimiento vencido sin diferimiento" id="o-cero"/>
    <element xsi:type="archimate:Outcome" name="Costo de mantenimiento de máximo 80.000 COP por hora de vuelo" id="o-costo"/>
    <element xsi:type="archimate:Principle" name="El estado del dron es la pieza central" id="p-estado">
      <documentation>Responder con certeza si cada dron puede volar hoy y por qué.</documentation>
    </element>
    <element xsi:type="archimate:Principle" name="Componentes y baterías tienen vida propia" id="p-vida"/>
    <element xsi:type="archimate:Principle" name="Nada se borra: las correcciones dejan rastro" id="p-nadaseborra"/>
    <element xsi:type="archimate:Requirement" name="Capturar el uso desde los fabricantes y acumularlo a dron, componentes y baterías" id="rq-uso"/>
    <element xsi:type="archimate:Requirement" name="Calcular vencimientos (lo que ocurra primero) y bloquear drones no aeronavegables" id="rq-bloqueo"/>
    <element xsi:type="archimate:Requirement" name="Planear la semana y proyectar 30 días de mantenimientos y repuestos" id="rq-plan"/>
    <element xsi:type="archimate:Requirement" name="Órdenes de trabajo digitales con checklist, fotos y doble firma" id="rq-ot"/>
    <element xsi:type="archimate:Requirement" name="Intercambiar con fabricantes, Siigo y Programación sin depender de ellos" id="rq-integrar"/>
    <element xsi:type="archimate:Requirement" name="Calcular indicadores y exportar el libro de mantenimiento" id="rq-evidencia"/>
    <element xsi:type="archimate:Constraint" name="Prevuelo, novedades y OT funcionan sin conexión y en menos de 2 minutos" id="c-offline"/>
    <element xsi:type="archimate:Constraint" name="No reemplazar Siigo: es dueño de existencias y costo" id="c-siigo"/>
    <element xsi:type="archimate:Constraint" name="Nube de costo moderado, login con Google y usuarios con roles" id="c-nube"/>
    <element xsi:type="archimate:Constraint" name="Invariante: no se duplican vuelos (mismo dron y hora de despegue)" id="inv-u1">
      <documentation>Invariante del agregado Lote de importación.</documentation>
      <property key="Rol" value="Invariante"/>
    </element>
    <element xsi:type="archimate:Constraint" name="Invariante: un dron no tiene vuelos solapados" id="inv-u2">
      <documentation>Invariante del agregado Registro de uso.</documentation>
      <property key="Rol" value="Invariante"/>
    </element>
    <element xsi:type="archimate:Constraint" name="Invariante: el dato del fabricante prima sobre el manual y el ajuste queda marcado" id="inv-u3">
      <documentation>Invariante del agregado Registro de uso.</documentation>
      <property key="Rol" value="Invariante"/>
    </element>
    <element xsi:type="archimate:Constraint" name="Invariante: nada se borra; la corrección exige motivo" id="inv-u4">
      <documentation>Invariante del agregado Registro de uso.</documentation>
      <property key="Rol" value="Invariante"/>
    </element>
    <element xsi:type="archimate:Constraint" name="Invariante: una posición tiene como máximo un componente; hélices por juego del mismo eje" id="inv-c1">
      <documentation>Invariante del agregado Dron.</documentation>
      <property key="Rol" value="Invariante"/>
    </element>
    <element xsi:type="archimate:Constraint" name="Invariante: solo gerencia da de baja un dron" id="inv-c3">
      <documentation>Invariante del agregado Dron.</documentation>
      <property key="Rol" value="Invariante"/>
    </element>
    <element xsi:type="archimate:Constraint" name="Invariante: conserva sus contadores al moverse; instalado en un solo dron a la vez" id="inv-c4">
      <documentation>Invariante del agregado Componente controlado.</documentation>
      <property key="Rol" value="Invariante"/>
    </element>
    <element xsi:type="archimate:Constraint" name="Invariante: se retira a 1.000 ciclos o salud menor al 80 %; pertenece a la base, no al dron" id="inv-c6">
      <documentation>Invariante del agregado Batería.</documentation>
      <property key="Rol" value="Invariante"/>
    </element>
    <element xsi:type="archimate:Constraint" name="Invariante: los cambios aplican desde su fecha sin reescribir el pasado" id="inv-p1">
      <documentation>Invariante del agregado Plan maestro de tareas.</documentation>
      <property key="Rol" value="Invariante"/>
    </element>
    <element xsi:type="archimate:Constraint" name="Invariante: aplica la condición que ocurra primero; desde el 90 % del intervalo la tarea está próxima a vencer" id="inv-p2">
      <documentation>Invariante del agregado Seguimiento de vencimientos.</documentation>
      <property key="Rol" value="Invariante"/>
    </element>
    <element xsi:type="archimate:Constraint" name="Invariante: cumplir la tarea o reemplazar el componente reinicia el contador" id="inv-p4">
      <documentation>Invariante del agregado Seguimiento de vencimientos.</documentation>
      <property key="Rol" value="Invariante"/>
    </element>
    <element xsi:type="archimate:Constraint" name="Invariante: solo el jefe de mantenimiento aprueba el plan" id="inv-p5">
      <documentation>Invariante del agregado Plan semanal.</documentation>
      <property key="Rol" value="Invariante"/>
    </element>
    <element xsi:type="archimate:Constraint" name="Invariante: con tarea vencida sin diferimiento o novedad abierta, el dron no está disponible" id="inv-a1">
      <documentation>Invariante del agregado Estado de aeronavegabilidad.</documentation>
      <property key="Rol" value="Invariante"/>
    </element>
    <element xsi:type="archimate:Constraint" name="Invariante: solo libera un técnico certificado para el modelo" id="inv-a2">
      <documentation>Invariante del agregado Estado de aeronavegabilidad.</documentation>
      <property key="Rol" value="Invariante"/>
    </element>
    <element xsi:type="archimate:Constraint" name="Invariante: tras caída o aterrizaje brusco, inspección completa antes de liberar" id="inv-a3">
      <documentation>Invariante del agregado Estado de aeronavegabilidad.</documentation>
      <property key="Rol" value="Invariante"/>
    </element>
    <element xsi:type="archimate:Constraint" name="Invariante: tareas críticas no se difieren" id="inv-a4">
      <documentation>Invariante del agregado Diferimiento.</documentation>
      <property key="Rol" value="Invariante"/>
    </element>
    <element xsi:type="archimate:Constraint" name="Invariante: una sola vez, máximo 10 % del intervalo o 7 días; solo lo aprueba el jefe o su delegado" id="inv-a5">
      <documentation>Invariante del agregado Diferimiento.</documentation>
      <property key="Rol" value="Invariante"/>
    </element>
    <element xsi:type="archimate:Constraint" name="Invariante: toda novedad tiene categoría de falla" id="inv-a6">
      <documentation>Invariante del agregado Novedad.</documentation>
      <property key="Rol" value="Invariante"/>
    </element>
    <element xsi:type="archimate:Constraint" name="Invariante: la orden pasa por programada, en ejecución, pendiente de inspección y cerrada; cerrada no se modifica" id="inv-o1">
      <documentation>Invariante del agregado Orden de trabajo.</documentation>
      <property key="Rol" value="Invariante"/>
    </element>
    <element xsi:type="archimate:Constraint" name="Invariante: en tareas críticas el inspector es distinto del ejecutor" id="inv-o2">
      <documentation>Invariante del agregado Orden de trabajo.</documentation>
      <property key="Rol" value="Invariante"/>
    </element>
    <element xsi:type="archimate:Constraint" name="Invariante: solo técnicos certificados en el modelo ejecutan y firman" id="inv-o3">
      <documentation>Invariante del agregado Orden de trabajo.</documentation>
      <property key="Rol" value="Invariante"/>
    </element>
    <element xsi:type="archimate:Constraint" name="Invariante: un valor fuera de rango deja la tarea no conforme; todo correctivo exige la causa de la falla" id="inv-o4">
      <documentation>Invariante del agregado Orden de trabajo.</documentation>
      <property key="Rol" value="Invariante"/>
    </element>
    <element xsi:type="archimate:Constraint" name="Invariante: el regreso exige informe e inspección de recibo" id="inv-o5">
      <documentation>Invariante del agregado Envío a taller externo.</documentation>
      <property key="Rol" value="Invariante"/>
    </element>
    <element xsi:type="archimate:Constraint" name="Invariante: la reserva se valida contra la existencia de Siigo" id="inv-r1">
      <documentation>Invariante del agregado Reserva de repuestos.</documentation>
      <property key="Rol" value="Invariante"/>
    </element>
    <element xsi:type="archimate:Constraint" name="Invariante: si Siigo no responde, la salida queda pendiente y se reenvía" id="inv-r2">
      <documentation>Invariante del agregado Reserva de repuestos.</documentation>
      <property key="Rol" value="Invariante"/>
    </element>
    <element xsi:type="archimate:Constraint" name="Invariante: una necesidad pertenece a una sola base y periodo y se calcula contra la existencia de esa bodega" id="inv-r3">
      <documentation>Invariante del agregado Necesidad proyectada.</documentation>
      <property key="Rol" value="Invariante"/>
    </element>
    <element xsi:type="archimate:Constraint" name="Invariante: sin certificación vigente para el modelo no se vuela ni se firma" id="inv-h1">
      <documentation>Invariante del agregado Habilitación de personal.</documentation>
      <property key="Rol" value="Invariante"/>
    </element>
    <element xsi:type="archimate:Constraint" name="Invariante: solo incluye registros firmados; las correcciones muestran el original" id="inv-i1">
      <documentation>Invariante del agregado Indicadores y libro.</documentation>
      <property key="Rol" value="Invariante"/>
    </element>
    <element xsi:type="archimate:Constraint" name="Invariante: cada notificación va a un usuario individual según su rol, por correo o push" id="inv-n1">
      <documentation>Invariante del agregado Notificación.</documentation>
      <property key="Rol" value="Invariante"/>
    </element>
    <element xsi:type="archimate:Outcome" name="Libro de mantenimiento de cualquier dron exportable en minutos" id="o-evidencia">
      <documentation>Hoy reunir los registros de 5 drones para la Aerocivil tomó 2 días; el auditor ISO marcó la trazabilidad como el punto más débil.</documentation>
    </element>
    <element xsi:type="archimate:Meaning" name="Responde «¿este dron puede volar hoy?» y con qué motivo" id="mn-estado">
      <documentation>Significado de «Estado de aeronavegabilidad» en Aeronavegabilidad y estado de flota: Respuesta a «¿este dron puede volar hoy?», con su motivo: disponible, disponible con restricción, en mantenimiento, en tierra por falla, fuera de servicio o dado de baja.</documentation>
      <property key="Contexto" value="Aeronavegabilidad y estado de flota"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Sinónimos" value="estado del dron; estado real de cada dron"/>
      <property key="Fuente" value="§10 Cierre: «El estado del dron es la pieza central… ¿este dron puede volar hoy?»; §5: tablero de estado de la flota"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Revisión del piloto antes de cada jornada; si un punto falla, el dron no vuela" id="mn-lu-prev">
      <documentation>Significado de «Inspección prevuelo» en Aeronavegabilidad y estado de flota: Revisión que el piloto hace antes de cada jornada; si algún punto falla, el dron no vuela y se reporta la novedad.</documentation>
      <property key="Contexto" value="Aeronavegabilidad y estado de flota"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Sinónimos" value="prevuelo; formato FM-02"/>
      <property key="Fuente" value="§3 regla 21: «Antes de cada jornada el piloto hace la inspección prevuelo; si algún punto falla, el dron no vuela»"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Tareas e intervalos por modelo que define y aprueba el jefe de mantenimiento" id="mn-lu-pmaestro">
      <documentation>Significado de «Plan maestro de tareas» en Planeación del mantenimiento: Conjunto de tareas e intervalos por modelo que define y aprueba el jefe de mantenimiento; los cambios quedan registrados y aplican desde su fecha sin reescribir el pasado.</documentation>
      <property key="Contexto" value="Planeación del mantenimiento"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Sinónimos" value="matriz de mantenimiento; matriz maestra de tareas e intervalos; Excel maestro; MM-01"/>
      <property key="Fuente" value="§6: «Es quien aprueba cambios en el plan maestro de tareas e intervalos»"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Medición y ajuste de caudal y gota; vencida, no se autoriza aplicar" id="mn-lu-calib">
      <documentation>Significado de «Calibración de boquillas y caudal» en Planeación del mantenimiento: Tarea que mide y ajusta el caudal y el tamaño de gota de las boquillas (50 h o 15 días); si está vencida, el agrónomo no autoriza la aplicación aunque el dron esté mecánicamente bien.</documentation>
      <property key="Contexto" value="Planeación del mantenimiento"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Sinónimos" value="calibración; formato FM-06"/>
      <property key="Fuente" value="§3 regla 22: «La calibración de boquillas y caudal debe estar vigente para aplicar»"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Pertenece a la base, rota entre drones y cuenta sus propios ciclos" id="mn-bateria">
      <documentation>Significado de «Batería» en Configuración de flota y vida de componentes: Batería inteligente de vuelo; pertenece a la base y rota entre drones; su uso se cuenta por la batería misma.</documentation>
      <property key="Contexto" value="Configuración de flota y vida de componentes"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Sinónimos" value="batería inteligente"/>
      <property key="Fuente" value="§3 regla 5: «Las baterías no pertenecen a un dron: pertenecen a la base y rotan»"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Horas, ciclos y baterías de cada vuelo que alimentan los acumulados" id="mn-uso">
      <documentation>Significado de «Registro de uso» en Registro de uso: Horas, ciclos y baterías de cada vuelo ya consolidados, vengan del fabricante o del piloto, que alimentan los acumulados.</documentation>
      <property key="Contexto" value="Registro de uso"/>
      <property key="Clasificación" value="Soporte"/>
      <property key="Sinónimos" value="uso; horas y ciclos"/>
      <property key="Fuente" value="§10 (7): «primero el registro de uso, la configuración de componentes…»"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Intervención sobre un dron; pasa de programada a cerrada y cerrada no se modifica" id="mn-ot">
      <documentation>Significado de «Orden de trabajo» en Órdenes de trabajo: Registro de una intervención sobre un dron (preventiva, correctiva, aviso del fabricante o inspección especial). Pasa por programada, en ejecución, pendiente de inspección y cerrada; puede quedar suspendida por repuesto; cerrada no se modifica.</documentation>
      <property key="Contexto" value="Órdenes de trabajo"/>
      <property key="Clasificación" value="Soporte"/>
      <property key="Sinónimos" value="OT; formato FM-03"/>
      <property key="Fuente" value="§8: «Las órdenes pasan por estos momentos: programada → en ejecución → pendiente de inspección… → cerrada»"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Lista de tareas de la orden con resultado conforme, no conforme o no aplica" id="mn-lu-check">
      <documentation>Significado de «Checklist» en Órdenes de trabajo: Lista de tareas de la orden, cada una con resultado conforme, no conforme o no aplica.</documentation>
      <property key="Contexto" value="Órdenes de trabajo"/>
      <property key="Clasificación" value="Soporte"/>
      <property key="Sinónimos" value="formato FM-05 (servicio de 100 h)"/>
      <property key="Fuente" value="§8: «Checklist de cada tarea con resultado: conforme / no conforme / no aplica»"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Cantidad de un repuesto en la bodega de una base, según Siigo" id="mn-lu-exist">
      <documentation>Significado de «Existencia» en Abastecimiento de repuestos: Cantidad disponible de un repuesto en la bodega de una base, según Siigo.</documentation>
      <property key="Contexto" value="Abastecimiento de repuestos"/>
      <property key="Clasificación" value="Soporte"/>
      <property key="Sinónimos" value="existencias; stock"/>
      <property key="Fuente" value="§9: «Siigo es el dueño de las existencias y del costo»"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Acreditación de piloto o técnico con modelos habilitados y vencimiento" id="mn-lu-cert">
      <documentation>Significado de «Certificación» en Personal habilitado: Acreditación de un piloto o técnico con tipo, modelos habilitados, fecha de expedición y vencimiento; la lleva Talento humano.</documentation>
      <property key="Contexto" value="Personal habilitado"/>
      <property key="Clasificación" value="Genérico"/>
      <property key="Sinónimos" value="certificado"/>
      <property key="Fuente" value="§9: «persona, rol, tipo de certificación, modelos habilitados, fecha de expedición y vencimiento»"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Evidencia completa de un dron, exportable en PDF y conservada 5 años" id="mn-libro">
      <documentation>Significado de «Libro de mantenimiento» en Indicadores y reportes: Evidencia completa de un dron, exportable en PDF: hoja de vida, horas y ciclos, configuración, órdenes, diferimientos, liberaciones, fallas, calibraciones y avisos; se conserva 5 años tras la baja.</documentation>
      <property key="Contexto" value="Indicadores y reportes"/>
      <property key="Clasificación" value="Genérico"/>
      <property key="Sinónimos" value="historial del dron"/>
      <property key="Fuente" value="§6: «Por cada dron necesitamos poder mostrar su “libro de mantenimiento”»"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Aviso a una persona según su rol, por correo o celular; reemplaza WhatsApp" id="mn-notificacion">
      <documentation>Significado de «Notificación» en Identidad y notificaciones: Aviso por correo o notificación en el celular a una persona según su rol: orden asignada, falla o diferimiento por aprobar, dron en tierra, faltantes proyectados; reemplaza WhatsApp.</documentation>
      <property key="Contexto" value="Identidad y notificaciones"/>
      <property key="Clasificación" value="Genérico"/>
      <property key="Sinónimos" value="aviso; alerta"/>
      <property key="Fuente" value="§9 [V]: «Nos gustaría que el sistema avise (por correo o notificación en el celular…)»"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Un despegue y un aterrizaje; cada salida de aspersión es un ciclo" id="mn-lu-cicdron">
      <documentation>Significado de «Ciclo de dron» en Registro de uso: Un despegue y un aterrizaje; cada salida de aspersión es un ciclo.</documentation>
      <property key="Contexto" value="Registro de uso"/>
      <property key="Clasificación" value="Soporte"/>
      <property key="Sinónimos" value="ciclo; salida"/>
      <property key="Fuente" value="§3 regla 2: «Un ciclo de dron es un despegue y un aterrizaje»"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Una descarga en vuelo y su recarga; la cuenta la propia batería" id="mn-lu-cicbat">
      <documentation>Significado de «Ciclo de batería» en Configuración de flota y vida de componentes: Una descarga en vuelo y su recarga; lo cuenta la propia batería y se ve en la app del fabricante.</documentation>
      <property key="Contexto" value="Configuración de flota y vida de componentes"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Sinónimos" value="ciclo"/>
      <property key="Fuente" value="§3 regla 3: «Un ciclo de batería es una descarga en vuelo y su recarga»"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Uso desde la última ejecución de una tarea; se reinicia al cumplirla" id="mn-lu-contador">
      <documentation>Significado de «Contador de la tarea» en Planeación del mantenimiento: Uso o tiempo transcurrido desde la última ejecución de una tarea; se reinicia al cumplirla, al darla por cumplida en un correctivo o al reemplazar el componente.</documentation>
      <property key="Contexto" value="Planeación del mantenimiento"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Sinónimos" value="contador"/>
      <property key="Fuente" value="§3 regla 7: «Cuando se ejecuta la tarea, su contador se reinicia desde ese momento»"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Horas y ciclos que suma el dron o el componente; viajan con el componente" id="mn-lu-acum">
      <documentation>Significado de «Acumulado de horas y ciclos» en Configuración de flota y vida de componentes: Horas y ciclos que suman el dron y cada componente controlado instalado; el componente se lleva su acumulado al cambiar de dron.</documentation>
      <property key="Contexto" value="Configuración de flota y vida de componentes"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Sinónimos" value="acumulado; contadores (modelo y §4)"/>
      <property key="Fuente" value="§3 regla 4: «Si el componente se pasa a otro dron, se lleva su acumulado»"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Momento (fecha, horas o ciclos) en que una tarea deja de estar al día" id="mn-vencimiento">
      <documentation>Significado de «Vencimiento de tarea» en Planeación del mantenimiento: Momento (fecha, horas o ciclos) en que una tarea deja de estar al día para un dron, componente o batería concreto.</documentation>
      <property key="Contexto" value="Planeación del mantenimiento"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Sinónimos" value="vencimiento; próximo mantenimiento"/>
      <property key="Fuente" value="§8: «Cálculo continuo de vencimientos con las reglas de “lo que ocurra primero”»"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Fecha en que una certificación pierde vigencia; sin ella no se vuela ni se firma" id="mn-lu-vcert">
      <documentation>Significado de «Vencimiento de certificación» en Personal habilitado: Fecha en que una certificación deja de estar vigente; sin vigencia no se vuela ni se firma.</documentation>
      <property key="Contexto" value="Personal habilitado"/>
      <property key="Clasificación" value="Genérico"/>
      <property key="Sinónimos" value="certificado vencido"/>
      <property key="Fuente" value="§2: «Un piloto con certificado vencido no puede volar, y un técnico sin certificación vigente no debería firmar»"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Estado de cada dron por día que Mantenimiento entrega a Programación" id="mn-disponibilidad">
      <documentation>Significado de «Disponibilidad de la flota» en Aeronavegabilidad y estado de flota: Estado y disponibilidad de cada dron por día, con restricciones y ventanas de mantenimiento, que Mantenimiento entrega a Programación de servicios.</documentation>
      <property key="Contexto" value="Aeronavegabilidad y estado de flota"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Sinónimos" value="disponibilidad de cada dron por día"/>
      <property key="Fuente" value="§9 (47): «Estado y disponibilidad de cada dron por día; ventanas de mantenimiento programadas»"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Días-dron disponibles sobre días-dron del periodo; meta 90 % o más" id="mn-lu-idisp">
      <documentation>Significado de «Indicador de disponibilidad» en Indicadores y reportes: Días-dron disponibles (incluye disponible con restricción) / días-dron totales del periodo, sin drones dados de baja; meta ≥ 90 %.</documentation>
      <property key="Contexto" value="Indicadores y reportes"/>
      <property key="Clasificación" value="Genérico"/>
      <property key="Sinónimos" value="disponibilidad de la flota"/>
      <property key="Fuente" value="§5 tabla: «Disponibilidad de la flota: Días-dron disponibles… / días-dron totales»"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Declaración firmada de que el dron vuelve a operar tras un mantenimiento" id="mn-lu-lib">
      <documentation>Significado de «Liberación a servicio» en Aeronavegabilidad y estado de flota: Declaración firmada, después de cualquier mantenimiento, por un técnico con certificación vigente para el modelo, de que el dron queda disponible, disponible con restricción o continúa en tierra.</documentation>
      <property key="Contexto" value="Aeronavegabilidad y estado de flota"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Sinónimos" value="liberar el dron; liberación para vuelo; «este dron puede volar»"/>
      <property key="Fuente" value="§3 regla 13: «el dron debe ser liberado a servicio por un técnico con certificación vigente para ese modelo»"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Grupo de tareas que se ejecutan juntas (servicio de 50 h, de 100 h, mayor)" id="mn-lu-paquete">
      <documentation>Significado de «Paquete de servicio» en Planeación del mantenimiento: Agrupación de tareas que se ejecutan juntas para no abrir el dron por cada tarea suelta (servicio de 50 h, de 100 h, servicio mayor); al ejecutarlo se cumplen todas sus tareas.</documentation>
      <property key="Contexto" value="Planeación del mantenimiento"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Sinónimos" value="paquete; servicio de 50 h; servicio de 100 h"/>
      <property key="Fuente" value="§8: «Las tareas se agrupan en paquetes (servicio de 50 h, de 100 h, servicio mayor)»"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Inspección completa tras caída o aterrizaje brusco, o al volver del taller" id="mn-lu-inspesp">
      <documentation>Significado de «Inspección especial» en Órdenes de trabajo: Orden fuera del plan: inspección completa tras caída o aterrizaje brusco, o inspección de recibo al regresar de taller externo.</documentation>
      <property key="Contexto" value="Órdenes de trabajo"/>
      <property key="Clasificación" value="Soporte"/>
      <property key="Sinónimos" value="inspección completa; inspección de recibo"/>
      <property key="Fuente" value="§8: «inspección especial (post-caída, recibo de taller externo)»"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Cambio de base de un dron; cambia su ubicación actual" id="mn-lu-trasdron">
      <documentation>Significado de «Traslado de dron» en Configuración de flota y vida de componentes: Cambio de base de un dron por picos de demanda o para mantenimiento en Rionegro; su ubicación actual cambia.</documentation>
      <property key="Contexto" value="Configuración de flota y vida de componentes"/>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Sinónimos" value="traslado"/>
      <property key="Fuente" value="§1: «cuando hay picos, trasladamos drones entre bases»"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Envío de repuestos desde la bodega de otra base (1 a 2 días)" id="mn-lu-trasrep">
      <documentation>Significado de «Traslado de repuestos» en Abastecimiento de repuestos: Envío de repuestos desde la bodega de otra base (1 a 2 días por transportadora).</documentation>
      <property key="Contexto" value="Abastecimiento de repuestos"/>
      <property key="Clasificación" value="Soporte"/>
      <property key="Sinónimos" value="traslado; solicitud de traslado"/>
      <property key="Fuente" value="§4: «el almacén revisa si hay en otra base y lo traslada (1 a 2 días por transportadora)»"/>
    </element>
  </folder>
  <folder name="Implementation &amp; Migration" id="id-cab3ccf9dada4bc8a73d63cf5850d2f8" type="implementation_migration"/>
  <folder name="Other" id="id-98b75b68b4854f4b81401fdd12d1828b" type="other">
    <element xsi:type="archimate:Grouping" name="Capacidades estratégicas" id="grp-cap-estrategicas"/>
    <element xsi:type="archimate:Grouping" name="Capacidades misionales" id="grp-cap-misionales"/>
    <element xsi:type="archimate:Grouping" name="Capacidades de apoyo" id="grp-cap-apoyo"/>
    <element xsi:type="archimate:Grouping" name="Alcance de la aplicación SGMF" id="grp-alcance">
      <documentation>El SGMF soporta el proceso paralelo de mantenimiento y sus interfaces.</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="Capa 1 - Proceso de negocio E2E" id="grp-l1"/>
    <element xsi:type="archimate:Grouping" name="Capa 2 - Servicios de negocio de plataforma" id="grp-l2"/>
    <element xsi:type="archimate:Grouping" name="Capa 3 - Servicios de dominio funcional" id="grp-l3"/>
    <element xsi:type="archimate:Grouping" name="Capa 4 - Servicios básicos de subdominio" id="grp-l4"/>
    <element xsi:type="archimate:Grouping" name="Capa 5 - Servicios de capa anticorrupción (interoperabilidad)" id="grp-l5"/>
    <element xsi:type="archimate:Grouping" name="Capa 6 - Servicios de subdominio fundamental (datos maestros)" id="grp-l6"/>
    <element xsi:type="archimate:Grouping" name="Capa 7 - Servicios de infraestructura" id="grp-l7"/>
    <element xsi:type="archimate:Grouping" name="Fuera de alcance (no se implementan)" id="grp-excluidos"/>
    <element xsi:type="archimate:Grouping" name="Dominios núcleo (core)" id="grp-nucleo">
      <documentation>Diferencian a AeroAgro; un CMMS genérico no los resolvió.</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="Dominios de soporte" id="grp-soporte">
      <documentation>Necesarios y propios del negocio, pero no diferenciadores.</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="Dominios genéricos" id="grp-generico">
      <documentation>Problemas comunes resolubles con soluciones existentes.</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="Dominio: Aeronavegabilidad y estado de flota" id="dom-aeronav">
      <documentation>Núcleo: decide si un dron puede volar hoy y por qué (bloqueo por vencimiento o novedad, diferimiento con límites, liberación con técnico certificado). Es la pregunta central de la empresa y concentra el riesgo de seguridad y de aseguradora. Ningún software genérico trae estas reglas.</documentation>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Justificación" value="Núcleo: decide si un dron puede volar hoy y por qué (bloqueo por vencimiento o novedad, diferimiento con límites, liberación con técnico certificado). Es la pregunta central de la empresa y concentra el riesgo de seguridad y de aseguradora. Ningún software genérico trae estas reglas."/>
    </element>
    <element xsi:type="archimate:Grouping" name="Dominio: Planeación del mantenimiento" id="dom-planeacion">
      <documentation>Núcleo: reglas propias (lo que ocurra primero, tolerancia del 90 %, intervalos ajustados por base, paquetes de servicio, proyección a 30 días con repuestos). Evita casos como el de julio de 2026 y hoy solo vive en la cabeza y el Excel del jefe.</documentation>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Justificación" value="Núcleo: reglas propias (lo que ocurra primero, tolerancia del 90 %, intervalos ajustados por base, paquetes de servicio, proyección a 30 días con repuestos). Evita casos como el de julio de 2026 y hoy solo vive en la cabeza y el Excel del jefe."/>
    </element>
    <element xsi:type="archimate:Grouping" name="Dominio: Configuración de flota y vida de componentes" id="dom-configuracion">
      <documentation>Núcleo: componentes y baterías con vida propia que conservan horas y ciclos al cambiar de dron o de base. Llevar solo las horas por dron no es suficiente; una de las caídas de 2025 ocurrió por no tener este control.</documentation>
      <property key="Clasificación" value="Núcleo"/>
      <property key="Justificación" value="Núcleo: componentes y baterías con vida propia que conservan horas y ciclos al cambiar de dron o de base. Llevar solo las horas por dron no es suficiente; una de las caídas de 2025 ocurrió por no tener este control."/>
    </element>
    <element xsi:type="archimate:Grouping" name="Dominio: Registro de uso" id="dom-uso">
      <documentation>Soporte: indispensable para alimentar los contadores, pero es normalización de datos. No diferencia al negocio.</documentation>
      <property key="Clasificación" value="Soporte"/>
      <property key="Justificación" value="Soporte: indispensable para alimentar los contadores, pero es normalización de datos. No diferencia al negocio."/>
    </element>
    <element xsi:type="archimate:Grouping" name="Dominio: Órdenes de trabajo" id="dom-ot">
      <documentation>Soporte: flujo de órdenes de trabajo con checklist, firmas y sin conexión. Es un patrón conocido de mantenimiento adaptado a reglas propias (doble firma, inspección remota).</documentation>
      <property key="Clasificación" value="Soporte"/>
      <property key="Justificación" value="Soporte: flujo de órdenes de trabajo con checklist, firmas y sin conexión. Es un patrón conocido de mantenimiento adaptado a reglas propias (doble firma, inspección remota)."/>
    </element>
    <element xsi:type="archimate:Grouping" name="Dominio: Abastecimiento de repuestos" id="dom-abastecimiento">
      <documentation>Soporte: Siigo es el dueño de existencias y costo; aquí solo reservas por OT, consumos y faltantes proyectados por base.</documentation>
      <property key="Clasificación" value="Soporte"/>
      <property key="Justificación" value="Soporte: Siigo es el dueño de existencias y costo; aquí solo reservas por OT, consumos y faltantes proyectados por base."/>
    </element>
    <element xsi:type="archimate:Grouping" name="Dominio: Personal habilitado" id="dom-personal">
      <documentation>Genérico: réplica de certificaciones que lleva Talento humano; el SGMF solo consulta vigencia y modelos habilitados.</documentation>
      <property key="Clasificación" value="Genérico"/>
      <property key="Justificación" value="Genérico: réplica de certificaciones que lleva Talento humano; el SGMF solo consulta vigencia y modelos habilitados."/>
    </element>
    <element xsi:type="archimate:Grouping" name="Dominio: Indicadores y reportes" id="dom-indicadores">
      <documentation>Genérico: modelos de lectura (KPI) y documentos PDF construidos con datos de los otros dominios; es un dominio de reportes y auditoría común a cualquier sistema.</documentation>
      <property key="Clasificación" value="Genérico"/>
      <property key="Justificación" value="Genérico: modelos de lectura (KPI) y documentos PDF construidos con datos de los otros dominios; es un dominio de reportes y auditoría común a cualquier sistema."/>
    </element>
    <element xsi:type="archimate:Grouping" name="Dominio: Identidad y notificaciones" id="dom-plataforma">
      <documentation>Genérico: inicio de sesión con Google, roles y notificaciones por correo o push; servicios estándar del mercado.</documentation>
      <property key="Clasificación" value="Genérico"/>
      <property key="Justificación" value="Genérico: inicio de sesión con Google, roles y notificaciones por correo o push; servicios estándar del mercado."/>
    </element>
    <element xsi:type="archimate:Grouping" name="Ecosistema externo" id="grp-ecosistema">
      <documentation>Sistemas con los que interopera el SGMF.</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="Agregado: Lote de importación" id="agg-lote">
      <documentation>Alcance: Un archivo exportado por un fabricante y sus filas. Es agregado porque duplicados e inconsistencias se deciden para el lote completo.</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="Agregado: Registro de uso" id="agg-registro-uso">
      <documentation>Alcance: Un vuelo (despegue-aterrizaje) con horas, ciclos y baterías usadas; el registro y sus correcciones cambian juntos y nunca se borran.</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="Agregado: Dron" id="agg-dron">
      <documentation>Alcance: El dron con sus posiciones de instalación. No contiene componentes ni baterías porque tienen vida propia.</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="Agregado: Componente controlado" id="agg-componente">
      <documentation>Alcance: Motor, ESC, bomba, controlador de vuelo, RTK o radar con número de serie; conserva horas y ciclos al moverse entre drones.</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="Agregado: Batería" id="agg-bateria">
      <documentation>Alcance: Batería inteligente; pertenece a la base y rota entre drones; ciclos, salud, cuarentena y retiro.</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="Agregado: Plan maestro de tareas" id="agg-plan-maestro">
      <documentation>Alcance: Tareas preventivas por modelo con condiciones, criticidad, paquetes y ajustes por base; los cambios se versionan.</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="Agregado: Seguimiento de vencimientos" id="agg-seguimiento">
      <documentation>Alcance: Estado de cada tarea para un dron, componente o batería concreto: último cumplimiento y próximo vencimiento.</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="Agregado: Plan semanal" id="agg-plan-semanal">
      <documentation>Alcance: Intervenciones de la semana por base y proyección a 30 días; las aprueba el jefe.</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="Agregado: Estado de aeronavegabilidad" id="agg-estado">
      <documentation>Alcance: Responde si el dron puede volar hoy: estado, motivo, restricciones, prevuelo y liberación.</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="Agregado: Diferimiento" id="agg-diferimiento">
      <documentation>Alcance: Excepción aprobada sobre una tarea vencida, con límite y justificación.</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="Agregado: Novedad" id="agg-novedad">
      <documentation>Alcance: Falla reportada con categoría y fotos; mantiene el dron en tierra hasta su cierre.</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="Agregado: Orden de trabajo" id="agg-ot">
      <documentation>Alcance: Intervención sobre un dron: tareas, firmas, movimientos de componentes, consumos y horas-hombre; cerrada es inmutable.</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="Agregado: Envío a taller externo" id="agg-taller">
      <documentation>Alcance: Salida a taller externo o garantía y su regreso con informe.</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="Agregado: Reserva de repuestos" id="agg-reserva">
      <documentation>Alcance: Repuestos reservados para una OT y su salida hacia Siigo.</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="Agregado: Necesidad proyectada" id="agg-necesidad">
      <documentation>Alcance: Repuestos que harán falta por base en un periodo según la proyección, y las solicitudes generadas.</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="Agregado: Habilitación de personal" id="agg-habilitacion">
      <documentation>Alcance: Certificaciones de una persona y modelos que puede volar o mantener.</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="Agregado: Indicadores y libro" id="agg-indicador">
      <documentation>Alcance: Modelo de lectura: indicadores del periodo y libro de mantenimiento por dron.</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="Agregado: Notificación" id="agg-notificacion">
      <documentation>Alcance: Aviso a una persona por un evento del dominio.</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="Procesos internos fuera del SGMF" id="grp-contrapartes-internas">
      <documentation>Áreas de AeroAgro con proceso propio que intercambian información con el SGMF sin sistema propio integrable (se atienden por pantalla o archivo).</documentation>
      <property key="Fuente" value="Contrapartes de la capa 5 (V4a): propiedad «Tipo de contraparte»"/>
    </element>
    <element xsi:type="archimate:Grouping" name="Entidades externas sin API" id="grp-contrapartes-externas">
      <documentation>Organizaciones externas que no ofrecen API; el intercambio es por documentos (PDF, correo) o envío físico.</documentation>
      <property key="Fuente" value="Contrapartes de la capa 5 (V4a): propiedad «Tipo de contraparte»"/>
    </element>
  </folder>
